@model OlvideContrasenaViewModel
@{
    ViewData["Title"] = "Recuperar contraseña · Eventify JC";
}

<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    primary: "#1b2340",
                    accent: "#e8823c",
                    "accent-foreground": "#1b1206",
                    background: "#ffffff",
                    foreground: "#1b2340",
                    card: "#ffffff",
                    border: "#e6e5e0",
                    "muted-foreground": "#6b7080",
                },
                fontFamily: { display: ["Poppins", "sans-serif"] },
            },
        },
    };
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
    body {
        font-family: 'Inter', sans-serif;
    }

    .card-soft {
        box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06);
    }
</style>

<div class="min-h-screen bg-background">
    <section class="mx-auto grid max-w-md px-6 py-16">
        <div class="rounded-2xl border border-border bg-card p-8 card-soft">

            <div class="mb-6 flex justify-center">
                <div class="grid h-14 w-14 place-items-center rounded-2xl bg-accent/10 text-accent">
                    <i class="fa-solid fa-key text-xl"></i>
                </div>
            </div>

            <h1 class="font-display text-2xl font-bold text-primary text-center">Recuperar contraseña</h1>
            <p class="mt-2 text-sm text-muted-foreground text-center">
                Ingresa tu correo y te enviaremos una contraseña temporal.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700" asp-validation-summary="All"></div>
            }

            <form asp-controller="Account" asp-action="OlvideContrasena" method="post" class="mt-6 space-y-4">
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-primary"></label>
                    <input asp-for="Email" type="email" placeholder="tu@email.com"
                           class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                    <span asp-validation-for="Email" class="text-xs text-red-600"></span>
                </div>

                <button type="submit"
                        class="flex w-full items-center justify-center rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-foreground hover:bg-accent/90 transition">
                    <i class="fa-solid fa-envelope mr-2"></i>
                    Enviar contraseña temporal
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-muted-foreground">
                <a asp-controller="Account" asp-action="Login" class="font-semibold text-accent hover:underline">
                    ← Volver a iniciar sesión
                </a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}