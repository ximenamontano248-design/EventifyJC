@model CambiarContrasenaViewModel
@{
    ViewData["Title"] = "Cambiar contraseña · Eventify JC";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <a href="/Account/Perfil" class="inline-flex items-center text-sm text-accent hover:underline mb-4">
        <i class="fa-solid fa-arrow-left mr-2"></i> Volver a mi perfil
    </a>

    <div class="rounded-2xl border border-border bg-card p-8 card-soft">
        <div class="mb-6 flex justify-center">
            <div class="grid h-14 w-14 place-items-center rounded-2xl bg-accent/10 text-accent">
                <i class="fa-solid fa-key text-xl"></i>
            </div>
        </div>

        <h1 class="font-display text-2xl font-bold text-primary text-center">Cambiar contraseña</h1>
        <p class="mt-2 text-sm text-muted-foreground text-center">
            Ingresa tu contraseña actual y la nueva.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="mt-4 rounded-lg bg-green-50 p-3 text-sm text-green-800 border border-green-200">
                <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
            </div>
        }

        <div asp-validation-summary="All" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

        <form asp-controller="Account" asp-action="CambiarContrasena" method="post" class="mt-6 space-y-5">
            <div>
                <label asp-for="PasswordActual" class="block text-sm font-medium text-primary"></label>
                <input asp-for="PasswordActual" type="password" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="PasswordActual" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="PasswordNueva" class="block text-sm font-medium text-primary"></label>
                <input asp-for="PasswordNueva" type="password" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="PasswordNueva" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="PasswordConfirm" class="block text-sm font-medium text-primary"></label>
                <input asp-for="PasswordConfirm" type="password" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="PasswordConfirm" class="text-xs text-red-600"></span>
            </div>

            <button type="submit" class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
                <i class="fa-solid fa-check mr-1"></i> Cambiar contraseña
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}