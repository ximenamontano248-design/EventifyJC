@model EventifyJC.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="max-w-2xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Mi Perfil</h1>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form asp-action="ActualizarPerfil" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>

            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre Completo</label>
                    <input asp-for="Nombre" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <input asp-for="Email" readonly class="w-full border border-gray-300 rounded-lg px-4 py-2 bg-gray-50 cursor-not-allowed" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Teléfono</label>
                    <input asp-for="Telefono" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Rol</label>
                    <input value="@User.IsInRole("proveedor") ? " Proveedor" : "Organizador" " readonly class="w-full border border-gray-300 rounded-lg px-4 py-2 bg-gray-50 cursor-not-allowed" />
                </div>
            </div>

            <div class="mt-8 flex justify-end space-x-3">
                <a href="/" class="px-6 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancelar</a>
                <button type="submit" class="px-6 py-2.5 bg-accent text-white rounded-lg hover:bg-accent/90 transition">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>