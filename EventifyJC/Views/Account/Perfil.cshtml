@model PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil · Eventify JC";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    <div class="rounded-2xl border border-border bg-card p-8 card-soft">
        <div class="flex items-center gap-4 mb-6">
            <div class="h-16 w-16 rounded-2xl bg-accent/10 text-accent grid place-items-center text-2xl">
                <i class="fa-solid fa-user"></i>
            </div>
            <div>
                <h1 class="font-display text-2xl font-bold text-primary">Mi Perfil</h1>
                <p class="text-sm text-muted-foreground">
                    Rol: <span class="font-medium">@Model.Rol</span>
                    @if (Model.FechaRegistro.HasValue)
                    {
                        <span> · Miembro desde @Model.FechaRegistro.Value.ToString("MMM yyyy")</span>
                    }
                </p>
            </div>
        </div>

        <div asp-validation-summary="All" class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

        <form asp-controller="Account" asp-action="Perfil" method="post" class="space-y-5">
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-primary"></label>
                <input asp-for="Nombre" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="Nombre" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-primary"></label>
                <input asp-for="Email" disabled class="mt-1 w-full rounded-lg border border-border bg-secondary/40 px-3 py-2 text-sm text-muted-foreground" />
                <p class="mt-1 text-xs text-muted-foreground">El correo no se puede cambiar.</p>
            </div>

            <div>
                <label asp-for="Telefono" class="block text-sm font-medium text-primary"></label>
                <input asp-for="Telefono" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="Telefono" class="text-xs text-red-600"></span>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
                    <i class="fa-solid fa-save mr-1"></i> Guardar cambios
                </button>
                <a href="/Account/CambiarContrasena" class="rounded-xl border border-border px-5 py-2.5 text-sm hover:bg-secondary transition">
                    <i class="fa-solid fa-key mr-1"></i> Cambiar contraseña
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}