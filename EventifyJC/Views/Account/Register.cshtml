@model RegisterViewModel

@{
    ViewData["Title"] = "Crear cuenta · Eventify JC";
}

<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
    theme: {
    extend: {
    colors: {
    primary: "#1b2340",
    accent: "#e8823c",
    "accent-foreground": "#1b1206",
    background: "#ffffff",
    foreground: "#1b2340",
    card: "#ffffff",
    border: "#e6e5e0",
    "muted-foreground": "#6b7080",
    },
    fontFamily: { display: ["Poppins", "sans-serif"] },
    },
    },
    };
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
    body {
    font-family: 'Inter', sans-serif;
    }

    .card-soft {
    box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06);
    }
</style>


<div class="min-h-screen bg-background">
    <section class="mx-auto grid max-w-xl px-6 py-16">
        <div class="rounded-2xl border border-border bg-card p-8 card-soft">
            <h1 class="font-display text-2xl font-bold text-primary">Crear cuenta</h1>
            <p class="mt-1 text-sm text-muted-foreground">Elige el tipo de cuenta que necesitas.</p>

            <div asp-validation-summary="All" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

            <form asp-controller="Account" asp-action="Register" method="post" class="mt-6 space-y-5">

                <!-- Selector de rol -->
                <div class="grid grid-cols-2 gap-3">
                    <label class="cursor-pointer rounded-xl border border-border p-4 text-center has-[:checked]:border-accent has-[:checked]:bg-accent/10">
                        <input type="radio" asp-for="Rol" value="organizador" checked class="sr-only" onchange="toggleProveedor()" />
                        <span class="block font-semibold text-primary">Organizador</span>
                        <span class="block text-xs text-muted-foreground mt-1">Quiero contratar servicios</span>
                    </label>
                    <label class="cursor-pointer rounded-xl border border-border p-4 text-center has-[:checked]:border-accent has-[:checked]:bg-accent/10">
                        <input type="radio" asp-for="Rol" value="proveedor" class="sr-only" onchange="toggleProveedor()" />
                        <span class="block font-semibold text-primary">Proveedor</span>
                        <span class="block text-xs text-muted-foreground mt-1">Quiero ofrecer servicios</span>
                    </label>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Nombre" class="block text-sm font-medium text-primary"></label>
                        <input asp-for="Nombre" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        <span asp-validation-for="Nombre" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="Apellido" class="block text-sm font-medium text-primary"></label>
                        <input asp-for="Apellido" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        <span asp-validation-for="Apellido" class="text-xs text-red-600"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-primary"></label>
                    <input asp-for="Email" type="email" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                    <span asp-validation-for="Email" class="text-xs text-red-600"></span>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Password" class="block text-sm font-medium text-primary"></label>
                        <input asp-for="Password" type="password" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        <span asp-validation-for="Password" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="PasswordConfirm" class="block text-sm font-medium text-primary"></label>
                        <input asp-for="PasswordConfirm" type="password" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        <span asp-validation-for="PasswordConfirm" class="text-xs text-red-600"></span>
                    </div>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Telefono" class="block text-sm font-medium text-primary"></label>
                        <input asp-for="Telefono" placeholder="3001234567" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        <span asp-validation-for="Telefono" class="text-xs text-red-600"></span>
                    </div>
                   
                </div>

            
                <button type="submit" class="flex w-full items-center justify-center rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-foreground hover:bg-accent/90">
                    Crear cuenta
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-muted-foreground">
                ¿Ya tienes cuenta?
                <a asp-controller="Account" asp-action="Login" class="font-semibold text-accent hover:underline">Inicia sesión</a>
            </p>
        </div>
    </section>
</div>

<script>
    function toggleProveedor() {
    const esProveedor = document.querySelector('input[name="Rol"]:checked').value === 'proveedor';
    document.getElementById('camposProveedor').classList.toggle('hidden', !esProveedor);
    }
    document.addEventListener('DOMContentLoaded', toggleProveedor);
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}