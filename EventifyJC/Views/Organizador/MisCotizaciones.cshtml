@model List<Cotizacion>
@{
    ViewData["Title"] = "Mis Cotizaciones · Eventify JC";
    var estadoFiltro = (string?)ViewBag.EstadoFiltro;
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary">Mis Cotizaciones</h1>
            <p class="mt-1 text-muted-foreground">Todas las cotizaciones recibidas de proveedores.</p>
        </div>
        <a href="/Organizador" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Volver al dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-1"></i> @TempData["Error"]
        </div>
    }

    <!-- Filtros -->
    <form method="get" class="mb-6 flex flex-wrap gap-3">
        <select name="estado" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todos los estados</option>
            <option value="enviada" selected="@(estadoFiltro == "enviada")">Enviadas</option>
            <option value="aceptada" selected="@(estadoFiltro == "aceptada")">Aceptadas</option>
            <option value="rechazada" selected="@(estadoFiltro == "rechazada")">Rechazadas</option>
            <option value="expirada" selected="@(estadoFiltro == "expirada")">Expiradas</option>
        </select>
        <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm text-white font-medium hover:bg-accent/90 transition">Filtrar</button>
        <a href="/Organizador/MisCotizaciones" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">Limpiar</a>
    </form>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-envelope text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No tienes cotizaciones con esos filtros.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var c in Model)
            {
                var badge = c.Estado switch
                {
                    "aceptada"  => "bg-green-100 text-green-800",
                    "rechazada" => "bg-red-100 text-red-800",
                    "expirada"  => "bg-gray-100 text-gray-800",
                    _           => "bg-blue-100 text-blue-800"
                };

                var estadoTexto = c.Estado switch
                {
                    "aceptada"  => "Aceptada",
                    "rechazada" => "Rechazada",
                    "expirada"  => "Expirada",
                    _           => "Enviada"
                };

                <div class="rounded-2xl border border-border bg-card p-5 card-soft hover:shadow-md transition">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-primary">@c.IdServicioNavigation?.Nombre</h3>
                                <span class="rounded-full px-2.5 py-0.5 text-[10px] font-medium @badge">@estadoTexto</span>
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">
                                <i class="fa-solid fa-store mr-1"></i>@c.IdProveedorNavigation?.NombreComercial
                                · <i class="fa-solid fa-tag ml-2 mr-1"></i>@c.IdServicioNavigation?.IdCategoriaNavigation?.Nombre
                            </p>
                            <p class="text-sm text-muted-foreground">
                                <i class="fa-solid fa-file-lines mr-1"></i>Solicitud #@c.IdSolicitud
                                · <i class="fa-solid fa-calendar ml-2 mr-1"></i>Evento: @c.IdSolicitudNavigation?.FechaEvento.ToString("dd/MM/yyyy")
                            </p>
                            @if (!string.IsNullOrEmpty(c.Mensaje))
                            {
                                <p class="mt-2 text-sm text-muted-foreground italic">"@c.Mensaje"</p>
                            }
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-xs uppercase tracking-wider text-muted-foreground">Monto</p>
                            <p class="text-2xl font-bold text-accent">$ @c.Monto.ToString("N0")</p>
                            <a href="/Organizador/DetalleSolicitud/@c.IdSolicitud"
                               class="mt-2 inline-block rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent/90 transition">
                                Ver detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>