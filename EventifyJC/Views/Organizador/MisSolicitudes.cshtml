@model List<SolicitudCotizacion>
@{
    ViewData["Title"] = "Mis Solicitudes · Eventify JC";
    var estadoFiltro = (string?)ViewBag.EstadoFiltro;
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Encabezado -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary">Mis Solicitudes</h1>
            <p class="mt-1 text-muted-foreground">@ViewBag.Total solicitudes en total</p>
        </div>
        <div class="flex gap-2">
            <a href="/Organizador" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
                <i class="fa-solid fa-arrow-left mr-1"></i> Volver al dashboard
            </a>
            <a href="/Organizador/CrearSolicitud" class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
                <i class="fa-solid fa-plus mr-1"></i> Nueva solicitud
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <form method="get" class="mb-6 flex flex-wrap gap-3">
        <select name="estado" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todos los estados</option>
            <option value="pendiente" selected="@(estadoFiltro == "pendiente")">Pendiente</option>
            <option value="en_proceso" selected="@(estadoFiltro == "en_proceso")">En proceso</option>
            <option value="finalizada" selected="@(estadoFiltro == "finalizada")">Finalizada</option>
            <option value="cancelada" selected="@(estadoFiltro == "cancelada")">Cancelada</option>
        </select>
        <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm text-white font-medium hover:bg-accent/90 transition">
            Filtrar
        </button>
        <a href="/Organizador/MisSolicitudes" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            Limpiar
        </a>
    </form>

    <!-- Lista -->
    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-file-lines text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No tienes solicitudes con ese filtro.</p>
            <a href="/Organizador/CrearSolicitud" class="mt-3 inline-block rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
                Crear mi primera solicitud
            </a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var s in Model)
            {
                var count = s.Cotizacions?.Count ?? 0;
                var badge = s.Estado switch
                {
                    "pendiente"  => "bg-yellow-100 text-yellow-800",
                    "en_proceso" => "bg-blue-100 text-blue-800",
                    "finalizada" => "bg-green-100 text-green-800",
                    "cancelada"  => "bg-red-100 text-red-800",
                    _            => "bg-gray-100 text-gray-800"
                };

                <div class="rounded-2xl border border-border bg-card p-5 card-soft hover:shadow-md transition">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-primary">Solicitud #@s.IdSolicitud</h3>
                                <span class="rounded-full px-2.5 py-0.5 text-[10px] font-medium @badge">@s.Estado</span>
                                @if (count > 0)
                                {
                                    <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[10px] font-medium text-accent">
                                        <i class="fa-solid fa-envelope mr-1"></i>@count cotizaciones
                                    </span>
                                }
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">
                                <i class="fa-solid fa-calendar mr-1"></i>Evento: @s.FechaEvento.ToString("dd/MM/yyyy")
                                · <i class="fa-solid fa-clock ml-2 mr-1"></i>Publicada: @s.FechaSolicitud?.ToString("dd/MM/yyyy")
                            </p>
                            <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@s.DescripcionEvento</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-xs uppercase tracking-wider text-muted-foreground">Presupuesto</p>
                            <p class="text-xl font-bold text-accent">$ @(s.PresupuestoEstimado?.ToString("N0") ?? "—")</p>
                            <a href="/Organizador/DetalleSolicitud/@s.IdSolicitud"
                               class="mt-2 inline-block rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent/90 transition">
                                <i class="fa-solid fa-eye mr-1"></i>Ver cotizaciones
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>