@model SolicitudCotizacionViewModel
@{
    ViewData["Title"] = "Nueva solicitud · Eventify JC";
    var servicios = (List<Servicio>)ViewBag.Servicios;
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <a href="/Organizador" class="inline-flex items-center text-sm text-accent hover:underline mb-4">
        <i class="fa-solid fa-arrow-left mr-2"></i> Volver al panel
    </a>

    <div class="rounded-2xl border border-border bg-card p-8 card-soft">
        <h1 class="font-display text-2xl font-bold text-primary">Nueva solicitud de cotización</h1>
        <p class="mt-1 text-sm text-muted-foreground">Cuéntanos sobre tu evento y los proveedores te enviarán propuestas.</p>

        <div asp-validation-summary="All" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

        <form asp-controller="Organizador" asp-action="CrearSolicitud" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(Model.ServicioNombre))
            {
                <div class="rounded-xl bg-accent/5 border border-accent/20 p-4">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">Servicio seleccionado</p>
                    <p class="font-semibold text-primary">@Model.ServicioNombre</p>
                    <p class="text-sm text-muted-foreground">@Model.ProveedorNombre</p>
                </div>
                <input type="hidden" asp-for="ServicioId" />
                <input type="hidden" asp-for="ServicioNombre" />
                <input type="hidden" asp-for="ProveedorNombre" />
            }

            <div>
                <label asp-for="FechaEvento" class="block text-sm font-medium text-primary"></label>
                <input asp-for="FechaEvento" type="date" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="FechaEvento" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="DescripcionEvento" class="block text-sm font-medium text-primary"></label>
                <textarea asp-for="DescripcionEvento" rows="4" placeholder="Ej: Boda con 150 invitados, requerimos catering, decoración y música."
                          class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></textarea>
                <span asp-validation-for="DescripcionEvento" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="PresupuestoEstimado" class="block text-sm font-medium text-primary"></label>
                <input asp-for="PresupuestoEstimado" type="number" step="1000" placeholder="Ej: 5000000"
                       class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="PresupuestoEstimado" class="text-xs text-red-600"></span>
            </div>

            @if (Model.ServicioId == null)
            {
                <div>
                    <label class="block text-sm font-medium text-primary">¿Quieres cotizar un servicio específico? (opcional)</label>
                    <select name="ServicioId" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                        <option value="">— Ninguno, que los proveedores me envíen propuestas —</option>
                        @foreach (var s in servicios)
                        {
                            <option value="@s.IdServicio">
                                @s.Nombre — @s.IdProveedorNavigation?.NombreComercial
                            </option>
                        }
                    </select>
                </div>
            }

            <button type="submit" class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
                <i class="fa-solid fa-paper-plane mr-1"></i> Publicar solicitud
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}