@{
    ViewData["Title"] = "Mis Eventos · Eventify JC";
    var solicitudes = (List<SolicitudCotizacion>)ViewBag.UltimasSolicitudes;
    var cotizaciones = (List<Cotizacion>)ViewBag.UltimasCotizaciones;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

 <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">Mis Eventos</h1>
        <p class="mt-1 text-muted-foreground">Gestiona tus solicitudes, cotizaciones y reservas.</p>
    </div>
    <a href="/Organizador/CrearSolicitud" class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
        <i class="fa-solid fa-plus mr-1"></i> Nueva solicitud
    </a>
</div>

<!-- Accesos rápidos visibles -->
<div class="mt-6 flex flex-wrap gap-3">
    <a href="/Organizador/MisSolicitudes"
       class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-primary hover:border-accent/40 hover:bg-accent/5 transition">
        <i class="fa-solid fa-file-lines text-accent"></i> Mis Solicitudes
    </a>
    <a href="/Organizador/MisCotizaciones"
       class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-primary hover:border-accent/40 hover:bg-accent/5 transition">
        <i class="fa-solid fa-envelope text-blue-500"></i> Mis Cotizaciones
    </a>
    <a href="/Organizador/MisReservas"
       class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-primary hover:border-accent/40 hover:bg-accent/5 transition">
        <i class="fa-solid fa-calendar-check text-green-500"></i> Mis Reservas
    </a>
</div>

    @if (TempData["Success"] != null)
    {
        <div class="mt-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mt-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-1"></i> @TempData["Error"]
        </div>
    }

    <!-- Métricas -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/Organizador/MisSolicitudes" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 transition">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Solicitudes</span>
                <i class="fa-solid fa-file-lines text-accent"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalSolicitudes</p>
            <p class="text-xs text-muted-foreground mt-1">@ViewBag.SolicitudesAbiertas abiertas</p>
        </a>
        <a href="/Organizador/MisCotizaciones" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 transition">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Cotizaciones</span>
                <i class="fa-solid fa-envelope text-blue-500"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalCotizaciones</p>
            <p class="text-xs text-muted-foreground mt-1">@ViewBag.CotizacionesNuevas nuevas</p>
        </a>
        <a href="/Organizador/MisReservas" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 transition">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Reservas</span>
                <i class="fa-solid fa-calendar-check text-green-500"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalReservas</p>
            <p class="text-xs text-muted-foreground mt-1">Confirmadas</p>
        </a>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Total gastado</span>
                <i class="fa-solid fa-coins text-yellow-500"></i>
            </div>
            <p class="mt-2 text-2xl font-bold text-accent">$ @(((decimal)ViewBag.TotalGastado).ToString("N0"))</p>
        </div>
    </div>

    <!-- Últimas solicitudes y cotizaciones -->
    <div class="mt-10 grid gap-6 lg:grid-cols-2">

        <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft">
            <div class="border-b border-border bg-secondary/40 px-6 py-4 flex items-center justify-between">
                <h2 class="font-display text-base font-bold text-primary">Últimas solicitudes</h2>
                <a href="/Organizador/MisSolicitudes" class="text-sm text-accent hover:underline">Ver todas →</a>
            </div>
            @if (!solicitudes.Any())
            {
                <div class="p-8 text-center text-sm text-muted-foreground">
                    Aún no has creado solicitudes.
                </div>
            }
            else
            {
                <ul class="divide-y divide-border">
                    @foreach (var s in solicitudes)
                    {
                        <li class="px-6 py-3 hover:bg-secondary/20 transition">
                            <a href="/Organizador/DetalleSolicitud/@s.IdSolicitud" class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="font-medium text-primary text-sm truncate">Solicitud #@s.IdSolicitud</p>
                                    <p class="text-xs text-muted-foreground">
                                        <i class="fa-solid fa-calendar mr-1"></i>@s.FechaEvento.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                                <span class="shrink-0 rounded-full bg-secondary/60 px-2.5 py-0.5 text-[10px] text-muted-foreground">@s.Estado</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft">
            <div class="border-b border-border bg-secondary/40 px-6 py-4 flex items-center justify-between">
                <h2 class="font-display text-base font-bold text-primary">Últimas cotizaciones</h2>
                <a href="/Organizador/MisCotizaciones" class="text-sm text-accent hover:underline">Ver todas →</a>
            </div>
            @if (!cotizaciones.Any())
            {
                <div class="p-8 text-center text-sm text-muted-foreground">
                    Aún no has recibido cotizaciones.
                </div>
            }
            else
            {
                <ul class="divide-y divide-border">
                    @foreach (var c in cotizaciones)
                    {
                        <li class="px-6 py-3 hover:bg-secondary/20 transition">
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="font-medium text-primary text-sm truncate">@c.IdServicioNavigation?.Nombre</p>
                                    <p class="text-xs text-muted-foreground truncate">
                                        <i class="fa-solid fa-store mr-1"></i>@c.IdProveedorNavigation?.NombreComercial
                                    </p>
                                </div>
                                <span class="shrink-0 font-bold text-accent text-sm">$ @c.Monto.ToString("N0")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>