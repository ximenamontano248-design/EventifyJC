@model EventifyJC.Models.CotizarServicioViewModel
@{
    ViewData["Title"] = "Solicitar cotización";
    var tieneMatriz = ViewBag.TieneMatriz == true;
    var cantidades = ViewBag.CantidadesMatriz as List<int> ?? new List<int>();
    var horas = ViewBag.HorasMatriz as List<int> ?? new List<int>();
    var matrizJson = ViewBag.MatrizJson as string ?? "[]";
    var fechasOcupadas = ViewBag.FechasOcupadas as List<string> ?? new List<string>();
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- COLUMNA IZQUIERDA: FORMULARIO -->
        <div class="lg:col-span-2">
            <div class="rounded-2xl border border-border bg-card p-6 card-soft">
                <h1 class="font-display text-2xl font-bold text-primary mb-1">Solicitar cotización</h1>
                <p class="text-sm text-muted-foreground mb-6">
                    Completa los datos de tu evento. El proveedor confirmará la disponibilidad.
                </p>

                <div asp-validation-summary="All" class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

                <form asp-controller="Organizador" asp-action="CotizarServicio" method="post" id="formCotizar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ServicioId" />
                    <input type="hidden" asp-for="ServicioNombre" />
                    <input type="hidden" asp-for="ServicioDescripcion" />
                    <input type="hidden" asp-for="ServicioImagen" />
                    <input type="hidden" asp-for="CategoriaNombre" />
                    <input type="hidden" asp-for="PrecioBase" />
                    <input type="hidden" asp-for="ProveedorId" />
                    <input type="hidden" asp-for="ProveedorNombre" />

                    <!-- Fecha del evento -->
                    <div class="mb-5">
                        <label asp-for="FechaEvento" class="block text-sm font-semibold text-primary mb-2">
                            Fecha del evento
                        </label>
                        <input asp-for="FechaEvento" type="date" id="FechaEvento"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        <span asp-validation-for="FechaEvento" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Detalles del evento -->
                    <div class="mb-5">
                        <label asp-for="DescripcionEvento" class="block text-sm font-semibold text-primary mb-2">
                            Detalles del evento
                        </label>
                        <textarea asp-for="DescripcionEvento" rows="4"
                                  placeholder="Ej: Boda al aire libre, aproximadamente 120 invitados."
                                  class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></textarea>
                        <span asp-validation-for="DescripcionEvento" class="text-xs text-red-600"></span>
                    </div>

             
                    @if (tieneMatriz && cantidades.Any() && horas.Any())
                    {
                        <div class="mb-5 rounded-xl border border-border bg-secondary/20 p-4">
                            <p class="text-sm font-semibold text-primary mb-3">
                                <i class="fa-solid fa-calculator text-accent mr-1"></i>
                                Precio estimado según la matriz del proveedor
                            </p>

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-muted-foreground mb-1">Cantidad</label>
                                    <select id="CantidadSeleccionada" name="CantidadSeleccionada"
                                            class="w-full rounded-lg border border-border px-3 py-2 text-sm">
                                        @foreach (var c in cantidades)
                                        {
                                            <option value="@c">@c unidades/personas</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-muted-foreground mb-1">Horas</label>
                                    <select id="HorasSeleccionadas" name="HorasSeleccionadas"
                                            class="w-full rounded-lg border border-border px-3 py-2 text-sm">
                                        @foreach (var h in horas)
                                        {
                                            <option value="@h">@h horas</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <p class="mt-3 text-sm font-semibold">
                                Precio estimado:
                                <span id="precioEstimado" class="text-accent font-bold">Calculando...</span>
                            </p>
                        </div>
                    }

                    <!-- Botón -->
                    <button type="submit"
                            class="w-full rounded-xl bg-accent px-4 py-3 text-sm font-semibold text-white hover:bg-accent/90 transition">
                        <i class="fa-solid fa-paper-plane mr-2"></i>
                        Enviar solicitud y cotizar
                    </button>

                    <p class="mt-3 text-xs text-muted-foreground text-center">
                        Se generará una cotización automática con el precio base del servicio.
                    </p>
                </form>
            </div>
        </div>

        <!-- COLUMNA DERECHA: INFO DEL SERVICIO -->
        <div class="lg:col-span-1">
            <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft sticky top-24">
                @if (!string.IsNullOrEmpty(Model.ServicioImagen))
                {
                    <img src="@Model.ServicioImagen" alt="@Model.ServicioNombre"
                         class="w-full h-48 object-cover" />
                }
                else
                {
                    <div class="w-full h-48 bg-secondary/30 flex items-center justify-center">
                        <i class="fa-solid fa-image text-4xl text-muted-foreground"></i>
                    </div>
                }

                <div class="p-5">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">@Model.CategoriaNombre</p>
                    <h3 class="font-display text-lg font-bold text-primary mt-1">@Model.ServicioNombre</h3>

                    @if (!string.IsNullOrEmpty(Model.ServicioDescripcion))
                    {
                        <p class="text-xs text-muted-foreground mt-2 line-clamp-3">@Model.ServicioDescripcion</p>
                    }

                    <div class="mt-4 pt-4 border-t border-border">
                        <p class="text-xs uppercase tracking-wider text-muted-foreground">Precio base</p>
                        <p class="text-2xl font-bold text-accent mt-1">$ @Model.PrecioBase.ToString("N0")</p>
                    </div>

                    <div class="mt-4 pt-4 border-t border-border flex items-start gap-3">
                        <div class="h-10 w-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent flex-shrink-0">
                            <i class="fa-solid fa-store"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-semibold text-primary truncate">@Model.ProveedorNombre</p>
                                @if (Model.ProveedorVerificado)
                                {
                                    <i class="fa-solid fa-circle-check text-green-500 text-xs" title="Verificado"></i>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ProveedorCiudad))
                            {
                                <p class="text-xs text-muted-foreground">
                                    <i class="fa-solid fa-map-marker-alt mr-1"></i>@Model.ProveedorCiudad
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Matriz de precios del proveedor (serializada desde el controlador)
        const matriz = @Html.Raw(matrizJson);

        // Fechas ocupadas (por si quieres bloquearlas en el input de fecha)
        const fechasOcupadas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fechasOcupadas));

        // =========================================================
        // CÁLCULO DEL PRECIO ESTIMADO
        // =========================================================
        function calcularPrecio() {
            const selectCantidad = document.getElementById('CantidadSeleccionada');
            const selectHoras = document.getElementById('HorasSeleccionadas');
            const spanPrecio = document.getElementById('precioEstimado');

            // Si no existen los selects, no hay matriz
            if (!selectCantidad || !selectHoras || !spanPrecio) return;

            // Convertir a número (los <option> devuelven strings)
            const cantidad = parseInt(selectCantidad.value, 10);
            const horas = parseInt(selectHoras.value, 10);

            console.log('Buscando precio para:', { cantidad, horas });
            console.log('Matriz disponible:', matriz);

            // Buscar coincidencia exacta
            const item = matriz.find(m => 
                Number(m.cantidad) === cantidad && 
                Number(m.horas) === horas
            );

            if (item && Number(item.precio) > 0) {
                spanPrecio.textContent = '$ ' + Number(item.precio).toLocaleString('es-CO');
                spanPrecio.classList.remove('text-muted-foreground');
                spanPrecio.classList.add('text-accent');
            } else {
                spanPrecio.textContent = 'No disponible';
                spanPrecio.classList.remove('text-accent');
                spanPrecio.classList.add('text-muted-foreground');
            }
        }

        // Ejecutar al cargar la página
        document.addEventListener('DOMContentLoaded', function () {
            calcularPrecio();

            // Recalcular cuando cambie la cantidad o las horas
            const selectCantidad = document.getElementById('CantidadSeleccionada');
            const selectHoras = document.getElementById('HorasSeleccionadas');

            if (selectCantidad) selectCantidad.addEventListener('change', calcularPrecio);
            if (selectHoras) selectHoras.addEventListener('change', calcularPrecio);
        });
    </script>
}