@model List<SolicitudCotizacion>
@{
    ViewData["Title"] = "Solicitudes sin respuesta · Admin";
}

<div class="max-w-7xl mx-auto px-4 py-10">
    <h1 class="font-display text-3xl font-extrabold text-primary">Solicitudes sin respuesta</h1>
    <p class="mt-1 text-muted-foreground">Solicitudes pendientes que aún no han recibido ninguna cotización.</p>

    @if (!Model.Any())
    {
        <div class="mt-6 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-check-circle text-4xl text-green-500"></i>
            <p class="mt-3 text-muted-foreground">¡Todo en orden! No hay solicitudes sin respuesta.</p>
        </div>
    }
    else
    {
        <div class="mt-6 rounded-2xl border border-border bg-card overflow-hidden card-soft overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-secondary/30 text-left text-muted-foreground">
                    <tr>
                        <th class="px-6 py-3">#</th>
                        <th class="px-6 py-3">Organizador</th>
                        <th class="px-6 py-3">Fecha evento</th>
                        <th class="px-6 py-3">Presupuesto</th>
                        <th class="px-6 py-3">Días sin respuesta</th>
                        <th class="px-6 py-3">Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var dias = (DateTime.Now - (s.FechaSolicitud ?? DateTime.Now)).Days;
                        <tr class="border-b border-border hover:bg-secondary/20 transition">
                            <td class="px-6 py-3 font-medium">@s.IdSolicitud</td>
                            <td class="px-6 py-3">@s.IdOrganizadorNavigation?.Nombre</td>
                            <td class="px-6 py-3">@s.FechaEvento.ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-3 font-bold text-accent">$ @(s.PresupuestoEstimado?.ToString("N0") ?? "—")</td>
                            <td class="px-6 py-3">
                                <span class="rounded-full px-2.5 py-1 text-xs @(dias > 7 ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800")">
                                    @dias días
                                </span>
                            </td>
                            <td class="px-6 py-3 text-muted-foreground max-w-md truncate">@s.DescripcionEvento</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>