@model Proveedor
@{
    ViewData["Title"] = $"Verificación · {Model.NombreComercial}";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <a href="/Admin/RevisarDocumentos" class="inline-flex items-center text-sm text-accent hover:underline mb-4">
        <i class="fa-solid fa-arrow-left mr-2"></i> Volver a la lista
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-1"></i> @TempData["Error"]
        </div>
    }

    <!-- Encabezado del proveedor -->
    <div class="rounded-2xl border border-border bg-card p-6 card-soft mb-6">
        <div class="flex flex-wrap items-start gap-4">
            <div class="h-20 w-20 rounded-2xl bg-accent/10 flex items-center justify-center overflow-hidden shrink-0">
                <img src="@(Model.LogoUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.NombreComercial ?? "P")}&background=e8823c&color=fff&size=200")"
                     class="h-full w-full object-cover" />
            </div>
            <div class="flex-1 min-w-0">
                <h1 class="font-display text-2xl font-bold text-primary">@Model.NombreComercial</h1>
                <p class="text-sm text-muted-foreground">
                    <i class="fa-solid fa-user mr-1"></i>@Model.IdUsuarioNavigation?.Nombre
                    · <i class="fa-solid fa-envelope ml-2 mr-1"></i>@Model.IdUsuarioNavigation?.Email
                    · <i class="fa-solid fa-location-dot ml-2 mr-1"></i>@Model.Ciudad
                </p>
                <p class="text-xs text-muted-foreground mt-1">
                    NIT: @Model.Nit · Representante: @Model.Representante
                </p>
            </div>
            <div class="shrink-0">
                @if (Model.EstadoVerificacion == "verificado")
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
                        <i class="fa-solid fa-check-circle"></i> Verificado
                    </span>
                }
                else if (Model.EstadoVerificacion == "rechazado")
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-800">
                        <i class="fa-solid fa-times-circle"></i> Rechazado
                    </span>
                }
                else if (Model.EstadoVerificacion == "en_revision")
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800">
                        <i class="fa-solid fa-clock"></i> En revisión
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-yellow-100 px-3 py-1 text-sm font-medium text-yellow-800">
                        <i class="fa-solid fa-exclamation-triangle"></i> No verificado
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Documentos -->
    <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft mb-6">
        <div class="border-b border-border bg-secondary/30 px-6 py-4 flex items-center justify-between">
            <h2 class="font-display text-base font-bold text-primary">
                <i class="fa-solid fa-folder-open mr-2"></i>Documentos (@Model.DocumentosVerificacion.Count)
            </h2>
        </div>

        @if (!Model.DocumentosVerificacion.Any())
        {
            <div class="p-8 text-center text-sm text-muted-foreground">
                Este proveedor no ha subido documentos.
            </div>
        }
        else
        {
            <ul class="divide-y divide-border">
                @foreach (var doc in Model.DocumentosVerificacion.OrderByDescending(d => d.FechaSubida))
                {
                    var badge = doc.Estado switch
                    {
                        "aprobado"  => "bg-green-100 text-green-800",
                        "rechazado" => "bg-red-100 text-red-800",
                        _           => "bg-blue-100 text-blue-800"
                    };

                    <li class="px-6 py-4">
                        <div class="flex flex-wrap items-start gap-4">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-medium text-primary">@doc.NombreArchivo</span>
                                    <span class="rounded-full px-2 py-0.5 text-[10px] font-medium @badge">@doc.Estado</span>
                                    <span class="rounded-full bg-secondary/60 px-2 py-0.5 text-[10px] text-muted-foreground">@doc.Tipo</span>
                                </div>
                                <p class="text-xs text-muted-foreground mt-1">
                                    Subido: @doc.FechaSubida.ToString("dd/MM/yyyy HH:mm")
                                    @if (doc.FechaRevision.HasValue)
                                    {
                                        <span>· Revisado: @doc.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(doc.Observacion))
                                {
                                    <p class="mt-1 text-xs text-red-600">
                                        <strong>Observación:</strong> @doc.Observacion
                                    </p>
                                }
                            </div>

                            <div class="flex gap-2 shrink-0">
                                <a href="@doc.UrlArchivo" target="_blank"
                                   class="rounded-lg border border-border px-3 py-1.5 text-xs hover:bg-secondary transition">
                                    <i class="fa-solid fa-external-link-alt mr-1"></i> Abrir
                                </a>
                            </div>
                        </div>

                        <!-- Formulario de revisión -->
                        @if (doc.Estado == "pendiente")
                        {
                            <form asp-controller="Admin" asp-action="RevisarDocumento" method="post" class="mt-3 flex flex-wrap items-end gap-3 pt-3 border-t border-border">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="IdDocumento" value="@doc.IdDocumento" />

                                <div>
                                    <label class="block text-xs font-medium text-primary mb-1">Acción</label>
                                    <select name="Estado" class="rounded-lg border border-border px-3 py-1.5 text-sm">
                                        <option value="aprobado">Aprobar</option>
                                        <option value="rechazado">Rechazar</option>
                                    </select>
                                </div>

                                <div class="flex-1 min-w-[200px]">
                                    <label class="block text-xs font-medium text-primary mb-1">Observación (opcional)</label>
                                    <input type="text" name="Observacion" maxlength="500"
                                           placeholder="Ej: Documento vencido, imagen borrosa..."
                                           class="w-full rounded-lg border border-border px-3 py-1.5 text-sm" />
                                </div>

                                <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
                                    <i class="fa-solid fa-check mr-1"></i> Guardar revisión
                                </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <!-- Acciones finales -->
    @if (Model.EstadoVerificacion != "verificado")
    {
        <div class="rounded-2xl border border-border bg-card p-6 card-soft">
            <h2 class="font-display text-lg font-bold text-primary mb-4">Decisión final</h2>
            <div class="flex flex-wrap gap-3">
                <form asp-controller="Admin" asp-action="AprobarProveedor" method="post" class="inline"
                      onsubmit="return confirm('¿Aprobar este proveedor? Podrá publicar servicios.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdProveedor" />
                    <button type="submit" class="rounded-xl bg-green-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-green-700 transition">
                        <i class="fa-solid fa-check-circle mr-1"></i> Aprobar proveedor
                    </button>
                </form>
                <button type="button" onclick="document.getElementById('rechazoForm').classList.toggle('hidden')"
                        class="rounded-xl border border-red-200 px-6 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 transition">
                    <i class="fa-solid fa-times-circle mr-1"></i> Rechazar proveedor
                </button>
            </div>

            <div id="rechazoForm" class="hidden mt-4 pt-4 border-t border-border">
                <form asp-controller="Admin" asp-action="RechazarProveedor" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdProveedor" value="@Model.IdProveedor" />
                    <label class="block text-sm font-medium text-primary mb-2">Motivo del rechazo</label>
                    <textarea name="Motivo" rows="3" required maxlength="500"
                              placeholder="Ej: El RUT no coincide con el NIT registrado."
                              class="w-full rounded-lg border border-border px-3 py-2 text-sm"></textarea>
                    <button type="submit" class="mt-3 rounded-lg bg-red-600 px-5 py-2 text-sm font-semibold text-white hover:bg-red-700 transition">
                        <i class="fa-solid fa-paper-plane mr-1"></i> Enviar rechazo
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-green-200 bg-green-50 p-6">
            <p class="text-sm text-green-800">
                <i class="fa-solid fa-check-circle mr-1"></i>
                Este proveedor está verificado. Puede publicar servicios.
            </p>
        </div>
    }
</div>