@model List<Proveedor>
@{
    ViewData["Title"] = "Verificación de proveedores · Admin";
    var estadoFiltro = (string?)ViewBag.EstadoFiltro;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">Verificación de proveedores</h1>
            <p class="mt-1 text-muted-foreground">Revisa los documentos y aprueba o rechaza las solicitudes.</p>
        </div>
        <a href="/Admin" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Volver al panel
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mt-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mt-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-1"></i> @TempData["Error"]
        </div>
    }

    <!-- Métricas -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">En revisión</p>
            <p class="mt-2 text-3xl font-bold text-blue-600">@ViewBag.TotalEnRevision</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Verificados</p>
            <p class="mt-2 text-3xl font-bold text-green-600">@ViewBag.TotalVerificado</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Rechazados</p>
            <p class="mt-2 text-3xl font-bold text-red-600">@ViewBag.TotalRechazado</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Sin verificar</p>
            <p class="mt-2 text-3xl font-bold text-yellow-600">@ViewBag.TotalNoVerificado</p>
        </div>
    </div>

    <!-- Filtros -->
    <form method="get" class="mt-6 flex flex-wrap gap-3">
        <select name="estado" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todos los estados</option>
            <option value="no_verificado" selected="@(estadoFiltro == "no_verificado")">No verificado</option>
            <option value="en_revision" selected="@(estadoFiltro == "en_revision")">En revisión</option>
            <option value="verificado" selected="@(estadoFiltro == "verificado")">Verificado</option>
            <option value="rechazado" selected="@(estadoFiltro == "rechazado")">Rechazado</option>
        </select>
        <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm text-white font-medium hover:bg-accent/90 transition">
            Filtrar
        </button>
        <a href="/Admin/RevisarDocumentos" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            Limpiar
        </a>
    </form>

    <!-- Lista -->
    @if (!Model.Any())
    {
        <div class="mt-6 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-inbox text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No hay proveedores con esos filtros.</p>
        </div>
    }
    else
    {
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var p in Model)
            {
                var pendientes = p.DocumentosVerificacion.Count(d => d.Estado == "pendiente");
                var aprobados = p.DocumentosVerificacion.Count(d => d.Estado == "aprobado");
                var rechazados = p.DocumentosVerificacion.Count(d => d.Estado == "rechazado");

                var estadoBadge = p.EstadoVerificacion switch
                {
                    "verificado" => "bg-green-100 text-green-800",
                    "rechazado" => "bg-red-100 text-red-800",
                    "en_revision" => "bg-blue-100 text-blue-800",
                    _ => "bg-yellow-100 text-yellow-800"
                };
                var estadoTexto = p.EstadoVerificacion switch
                {
                    "verificado" => "Verificado",
                    "rechazado" => "Rechazado",
                    "en_revision" => "En revisión",
                    _ => "No verificado"
                };

                <div class="rounded-2xl border border-border bg-card p-5 card-soft">
                    <div class="flex items-start gap-3">
                        <div class="h-14 w-14 rounded-xl bg-accent/10 flex items-center justify-center overflow-hidden shrink-0">
                            <img src="@(p.LogoUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(p.NombreComercial ?? "P")}&background=e8823c&color=fff")"
                                 class="h-full w-full object-cover" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-primary truncate">@p.NombreComercial</h3>
                            <p class="text-xs text-muted-foreground truncate">
                                <i class="fa-solid fa-user mr-1"></i>@p.IdUsuarioNavigation?.Nombre
                            </p>
                            <p class="text-xs text-muted-foreground">
                                <i class="fa-solid fa-location-dot mr-1"></i>@p.Ciudad
                            </p>
                        </div>
                    </div>

                    <div class="mt-3 flex items-center gap-2 flex-wrap">
                        <span class="rounded-full px-2.5 py-0.5 text-xs font-medium @estadoBadge">@estadoTexto</span>
                        <span class="text-xs text-muted-foreground">@p.DocumentosVerificacion.Count docs</span>
                    </div>

                    <div class="mt-3 flex gap-2 text-xs">
                        @if (pendientes > 0)
                        {
                            <span class="rounded-full bg-blue-50 px-2 py-0.5 text-blue-700">@pendientes pendientes</span>
                        }
                        @if (aprobados > 0)
                        {
                            <span class="rounded-full bg-green-50 px-2 py-0.5 text-green-700">@aprobados ok</span>
                        }
                        @if (rechazados > 0)
                        {
                            <span class="rounded-full bg-red-50 px-2 py-0.5 text-red-700">@rechazados rechazados</span>
                        }
                    </div>

                    <a href="/Admin/DetalleVerificacion/@p.IdProveedor"
                       class="mt-4 flex w-full items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
                        <i class="fa-solid fa-eye mr-1"></i> Revisar documentos
                    </a>
                </div>
            }
        </div>
    }
</div>