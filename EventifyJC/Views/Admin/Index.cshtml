@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h1 class="text-3xl font-bold text-primary mb-8">Panel de Administración</h1>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <!-- === SECCIÓN USUARIOS (HU-04) === -->
    <div class="bg-white rounded-2xl border border-border p-6 card-soft mb-8">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold text-primary">Usuarios Registrados</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left">ID</th>
                        <th class="px-4 py-3 text-left">Nombre</th>
                        <th class="px-4 py-3 text-left">Email</th>
                        <th class="px-4 py-3 text-left">Rol</th>
                        <th class="px-4 py-3 text-left">Teléfono</th>
                        <th class="px-4 py-3 text-left">Estado</th>
                        <th class="px-4 py-3 text-left">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in ViewBag.Usuarios)
                    {
                        <tr class="border-b border-gray-100 hover:bg-slate-50">
                            <td class="px-4 py-3">@u.IdUsuario</td>
                            <td class="px-4 py-3 font-medium">@u.Nombre</td>
                            <td class="px-4 py-3">@u.Email</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded-full text-xs font-medium
                                    @(u.Rol == "admin" ? "bg-red-100 text-red-800" :
                                        u.Rol == "proveedor" ? "bg-blue-100 text-blue-800" :
                                        "bg-green-100 text-green-800")">
                                    @u.Rol
                                </span>
                            </td>
                            <td class="px-4 py-3">@u.Telefono</td>
                            <td class="px-4 py-3">
                                @if (u.Activo)
                                {
                                    <span class="px-2 py-1 rounded-full text-xs bg-green-100 text-green-800">Activo</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 rounded-full text-xs bg-red-100 text-red-800">Inactivo</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <form asp-controller="Admin" asp-action="AlternarEstadoUsuario" method="post" class="inline">
                                    <input type="hidden" name="id" value="@u.IdUsuario" />
                                    <button type="submit" class="px-3 py-1 rounded-lg text-xs font-medium
                                        @(u.Activo ? "bg-red-50 text-red-600 hover:bg-red-100" : "bg-green-50 text-green-600 hover:bg-green-100")">
                                        @(u.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- === SECCIÓN PROVEEDORES (HU-09) === -->
    <div class="bg-white rounded-2xl border border-border p-6 card-soft mb-8">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold text-primary">Proveedores</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left">ID</th>
                        <th class="px-4 py-3 text-left">Negocio</th>
                        <th class="px-4 py-3 text-left">Ciudad</th>
                        <th class="px-4 py-3 text-left">Categorías</th>
                        <th class="px-4 py-3 text-left">Verificado</th>
                        <th class="px-4 py-3 text-left">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in ViewBag.Proveedores)
                    {
                        <tr class="border-b border-gray-100 hover:bg-slate-50">
                            <td class="px-4 py-3">@p.IdProveedor</td>
                            <td class="px-4 py-3 font-medium">@p.NombreComercial</td>
                            <td class="px-4 py-3">@p.Ciudad</td>
                            <td class="px-4 py-3">@p.Categorias</td>
                            <td class="px-4 py-3">
                                @if (p.Verificado)
                                {
                                    <span class="px-2 py-1 rounded-full text-xs bg-green-100 text-green-800">
                                        <i class="fa-solid fa-check-circle mr-1"></i> Verificado
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 rounded-full text-xs bg-yellow-100 text-yellow-800">
                                        <i class="fa-solid fa-clock mr-1"></i> Pendiente
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                @if (!p.Verificado)
                                {
                                    <form asp-controller="Admin" asp-action="VerificarProveedor" method="post" class="inline">
                                        <input type="hidden" name="id" value="@p.IdProveedor" />
                                        <button type="submit" class="px-3 py-1 rounded-lg text-xs font-medium bg-blue-50 text-blue-600 hover:bg-blue-100">
                                            <i class="fa-solid fa-shield-halved mr-1"></i> Verificar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- === SECCIÓN CATEGORÍAS (HU-08) === -->
    <div class="bg-white rounded-2xl border border-border p-6 card-soft">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold text-primary">Categorías de Servicios</h2>
            <a href="/Admin/CrearCategoria" class="px-4 py-2 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-accent/90 transition">
                <i class="fa-solid fa-plus mr-2"></i> Nueva Categoría
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left">ID</th>
                        <th class="px-4 py-3 text-left">Nombre</th>
                        <th class="px-4 py-3 text-left">Descripción</th>
                        <th class="px-4 py-3 text-left">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in ViewBag.Categorias)
                    {
                        <tr class="border-b border-gray-100 hover:bg-slate-50">
                            <td class="px-4 py-3">@c.IdCategoria</td>
                            <td class="px-4 py-3 font-medium">@c.Nombre</td>
                            <td class="px-4 py-3">@c.Descripcion</td>
                            <td class="px-4 py-3">
                                <a href="/Admin/EditarCategoria/@c.IdCategoria" class="text-blue-600 hover:text-blue-800 mr-3">
                                    <i class="fa-solid fa-edit"></i> Editar
                                </a>
                                <form asp-controller="Admin" asp-action="EliminarCategoria" method="post" class="inline" onsubmit="return confirm('¿Eliminar esta categoría?');">
                                    <input type="hidden" name="id" value="@c.IdCategoria" />
                                    <button type="submit" class="text-red-600 hover:text-red-800">
                                        <i class="fa-solid fa-trash"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>