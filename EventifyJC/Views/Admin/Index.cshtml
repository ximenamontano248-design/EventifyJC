@{
    ViewData["Title"] = "Panel Admin · Eventify JC";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">Panel de Administración</h1>
            <p class="mt-1 text-muted-foreground">Resumen general de Eventify JC.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/Admin/Usuarios" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition"><i class="fa-solid fa-users mr-1"></i> Usuarios</a>
            <a href="/Admin/Proveedores" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition"><i class="fa-solid fa-store mr-1"></i> Proveedores</a>
            <a href="/Admin/Servicios" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition"><i class="fa-solid fa-briefcase mr-1"></i> Servicios</a>
            <a href="/Admin/Categorias" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition"><i class="fa-solid fa-tags mr-1"></i> Categorías</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mt-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">@TempData["Success"]</div>
    }

    <!-- Métricas -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Usuarios</p>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalUsuarios</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Proveedores</p>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalProveedores</p>
            <p class="text-xs text-green-600 mt-1"><i class="fa-solid fa-check"></i> @ViewBag.ProveedoresVerif verificados</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Servicios</p>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalServicios</p>
            <p class="text-xs text-muted-foreground mt-1">@ViewBag.TotalCategorias categorías</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Cotizaciones</p>
            <p class="mt-2 text-3xl font-bold text-accent">@ViewBag.TotalCotizaciones</p>
            <p class="text-xs text-muted-foreground mt-1">@ViewBag.TotalSolicitudes solicitudes · @ViewBag.TotalReservas reservas</p>
        </div>
    </div>

    <!-- Acciones rápidas -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/Admin/SolicitudesSinRespuesta" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 hover:-translate-y-1 transition">
            <i class="fa-solid fa-hourglass-half text-2xl text-accent"></i>
            <h3 class="mt-2 font-semibold text-primary">Solicitudes sin respuesta</h3>
            <p class="text-xs text-muted-foreground mt-1">Ver solicitudes pendientes sin cotización.</p>
        </a>
        <a href="/Admin/Auditoria" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 hover:-translate-y-1 transition">
            <i class="fa-solid fa-history text-2xl text-accent"></i>
            <h3 class="mt-2 font-semibold text-primary">Auditoría</h3>
            <p class="text-xs text-muted-foreground mt-1">Historial de cambios del sistema.</p>
        </a>
        <a href="/Admin/Proveedores?verificado=false" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 hover:-translate-y-1 transition">
            <i class="fa-solid fa-user-clock text-2xl text-accent"></i>
            <h3 class="mt-2 font-semibold text-primary">Proveedores pendientes</h3>
            <p class="text-xs text-muted-foreground mt-1">Verificar proveedores nuevos.</p>
        </a>
        <a href="/Admin/Categorias" class="rounded-2xl border border-border bg-card p-5 card-soft hover:border-accent/40 hover:-translate-y-1 transition">
            <i class="fa-solid fa-tags text-2xl text-accent"></i>
            <h3 class="mt-2 font-semibold text-primary">Categorías</h3>
            <p class="text-xs text-muted-foreground mt-1">Gestionar categorías del marketplace.</p>
        </a>
    </div>

    <!-- Top proveedores -->
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft">
            <div class="border-b border-border bg-secondary/50 px-6 py-4">
                <h2 class="font-display text-base font-bold text-primary">Top proveedores verificados</h2>
            </div>
            <ul class="divide-y divide-border">
                @foreach (var p in (List<Proveedor>)ViewBag.TopProveedores)
                {
                    <li class="px-6 py-3 flex items-center justify-between">
                        <div>
                            <p class="font-medium text-primary">@p.NombreComercial</p>
                            <p class="text-xs text-muted-foreground">@p.Ciudad</p>
                        </div>
                        <span class="text-accent font-bold">@(p.CalificacionPromedio?.ToString("F1") ?? "—") ★</span>
                    </li>
                }
            </ul>
        </div>

        <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft">
            <div class="border-b border-border bg-secondary/50 px-6 py-4">
                <h2 class="font-display text-base font-bold text-primary">Últimos usuarios registrados</h2>
            </div>
            <ul class="divide-y divide-border">
                @foreach (var u in (List<Usuario>)ViewBag.UltimosUsuarios)
                {
                    <li class="px-6 py-3 flex items-center justify-between">
                        <div>
                            <p class="font-medium text-primary">@u.Nombre</p>
                            <p class="text-xs text-muted-foreground">@u.Email</p>
                        </div>
                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs">@u.Rol</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>