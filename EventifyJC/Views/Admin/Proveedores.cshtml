@model List<Proveedor>
@{
    ViewData["Title"] = "Proveedores · Admin";
}

<div class="max-w-7xl mx-auto px-4 py-10">
    <h1 class="font-display text-3xl font-extrabold text-primary">Proveedores</h1>
    <p class="mt-1 text-muted-foreground">Administra y verifica los proveedores de la plataforma.</p>

    @if (TempData["Success"] != null)
    {
        <div class="mt-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mt-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-1"></i> @TempData["Error"]
        </div>
    }

    <!-- Filtros -->
    <form method="get" class="mt-6 flex flex-wrap gap-3">
        <input type="text" name="q" value="@ViewBag.Q" placeholder="Buscar por nombre, razón social o NIT..."
               class="flex-1 min-w-[200px] rounded-lg border border-border px-3 py-2 text-sm" />
        <select name="ciudad" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todas las ciudades</option>
            @foreach (var c in (List<string>)ViewBag.Ciudades)
            {
                <option value="@c" selected="@(ViewBag.Ciudad == c)">@c</option>
            }
        </select>
        <select name="verificado" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todos</option>
            <option value="true" selected="@(ViewBag.Verificado == true)">Verificados</option>
            <option value="false" selected="@(ViewBag.Verificado == false)">No verificados</option>
        </select>
        <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm text-white font-medium hover:bg-accent/90 transition">
            Filtrar
        </button>
        <a href="/Admin/Proveedores" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            Limpiar
        </a>
    </form>

    <!-- Lista de proveedores -->
    @if (!Model.Any())
    {
        <div class="mt-8 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-inbox text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No hay proveedores con esos filtros.</p>
        </div>
    }
    else
    {
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var p in Model)
            {
                <div class="rounded-2xl border border-border bg-card p-5 card-soft">

                    <!-- Encabezado -->
                    <div class="flex items-start gap-3">
                        <img src="@(p.LogoUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(p.NombreComercial ?? "N")}&background=e8823c&color=fff")"
                             class="h-14 w-14 rounded-xl object-cover shrink-0" />
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-primary truncate">@p.NombreComercial</h3>
                            <p class="text-xs text-muted-foreground">
                                <i class="fa-solid fa-location-dot"></i> @p.Ciudad
                            </p>
                            <p class="text-xs text-muted-foreground mt-1 truncate">
                                @p.Servicios.Count servicios · @p.Nit
                            </p>
                        </div>
                    </div>

                    <!-- Estado + acciones -->
                    <div class="mt-4 pt-4 border-t border-border flex items-center justify-between gap-2 flex-wrap">

                        <!-- Badge de estado -->
                        @if (p.Verificado == true && p.EstadoVerificacion == "verificado")
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-800">
                                <i class="fa-solid fa-check-circle"></i> Verificado
                            </span>
                        }
                        else if (p.EstadoVerificacion == "en_revision")
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-800">
                                <i class="fa-solid fa-clock"></i> En revisión
                            </span>
                        }
                        else if (p.EstadoVerificacion == "rechazado")
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-1 text-xs font-medium text-red-800">
                                <i class="fa-solid fa-times-circle"></i> Rechazado
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-yellow-100 px-2.5 py-1 text-xs font-medium text-yellow-800">
                                <i class="fa-solid fa-hourglass-half"></i> Pendiente
                            </span>
                        }

                        <!-- Acciones -->
                        <div class="flex gap-2">
                            <!-- Ver perfil público -->
                            <a href="/Proveedor/Ver/@p.IdProveedor" target="_blank"
                               class="rounded-lg border border-border px-2.5 py-1.5 text-xs hover:bg-secondary transition"
                               title="Ver perfil público">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <!-- Revisar documentos -->
                            <a href="/Admin/DetalleVerificacion/@p.IdProveedor"
                               class="rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent/90 transition"
                               title="Revisar documentos y verificar">
                                <i class="fa-solid fa-shield-halved mr-1"></i>Revisar
                            </a>

                            <!-- Eliminar -->
                            <form asp-controller="Admin" asp-action="EliminarProveedor" method="post"
                                  onsubmit="return confirm('¿Eliminar este proveedor y todos sus servicios? Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.IdProveedor" />
                                <button type="submit"
                                        class="rounded-lg border border-red-200 px-2.5 py-1.5 text-xs text-red-600 hover:bg-red-50 transition"
                                        title="Eliminar proveedor">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>