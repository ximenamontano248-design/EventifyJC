@model Proveedor
@{
    ViewData["Title"] = "Mi Negocio · Eventify JC";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <!-- Encabezado del negocio -->
    <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft">
        <div class="brand-gradient h-32 relative">
            <div class="absolute bottom-0 left-6 translate-y-1/2">
                <div class="h-24 w-24 rounded-2xl border-4 border-white bg-white overflow-hidden shadow-lg">
                    <img src="@(Model.LogoUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.NombreComercial ?? "Negocio")}&background=e8823c&color=fff&size=200")"
                         alt="@Model.NombreComercial"
                         class="h-full w-full object-cover" />
                </div>
            </div>
        </div>
        <div class="pt-16 pb-6 px-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="font-display text-2xl font-extrabold text-primary">@Model.NombreComercial</h1>
                        @if (Model.Verificado == true)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-800">
                                <i class="fa-solid fa-check-circle"></i> Verificado
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-yellow-100 px-2.5 py-1 text-xs font-medium text-yellow-800">
                                <i class="fa-solid fa-clock"></i> Pendiente de verificación
                            </span>
                        }
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground">
                        <i class="fa-solid fa-location-dot mr-1"></i> @Model.Ciudad
                        @if (!string.IsNullOrWhiteSpace(Model.Categorias))
                        {
                            <span> · <i class="fa-solid fa-tags mx-1"></i> @Model.Categorias</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                    {
                        <p class="mt-2 text-sm text-muted-foreground max-w-2xl">@Model.Descripcion</p>
                    }
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="/Proveedor/Ver/@Model.IdProveedor" target="_blank"
                       class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
                        <i class="fa-solid fa-eye mr-1"></i> Ver como cliente
                    </a>
                    <a href="/Proveedor/EditarPerfil"
                       class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
                        <i class="fa-solid fa-pen mr-1"></i> Editar perfil
                    </a>
                    <a href="/Proveedor/CrearServicio"
                       class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
                        <i class="fa-solid fa-plus mr-1"></i> Publicar servicio
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Métricas -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Servicios</span>
                <i class="fa-solid fa-briefcase text-accent"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalServicios</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Disponibles</span>
                <i class="fa-solid fa-check-circle text-green-500"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.ServiciosDisponibles</p>
        </div>
        <a href="/Proveedor/Cotizaciones"
           class="group rounded-2xl border border-border bg-card p-5 card-soft transition hover:border-accent/40 hover:shadow-md">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Cotizaciones</span>
                <i class="fa-solid fa-envelope text-blue-500"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalCotizaciones</p>
            <p class="text-xs text-muted-foreground mt-1">
                @ViewBag.CotizacionesPend pendientes · @ViewBag.CotizacionesAcep aceptadas
            </p>
            <p class="mt-2 text-xs font-semibold text-accent group-hover:underline">
                Ver todas →
            </p>
        </a>
        <a href="/Proveedor/Ver/@Model.IdProveedor" target="_blank"
           class="group rounded-2xl border border-border bg-card p-5 card-soft transition hover:border-accent/40 hover:shadow-md">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">Calificación</span>
                <i class="fa-solid fa-star text-yellow-400"></i>
            </div>
            <p class="mt-2 text-3xl font-bold text-accent">
                @(Model.CalificacionPromedio?.ToString("F1") ?? "—")
            </p>
            <p class="mt-2 text-xs font-semibold text-accent group-hover:underline">
                Ver reseñas →
            </p>
        </a>
    </div>

    <!-- Filtros -->
    <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-2xl font-bold text-primary">Mis servicios</h2>

        <form method="get" class="flex flex-wrap items-center gap-2">
            <input type="text" name="q" value="@ViewBag.Q" placeholder="Buscar servicio..."
                   class="rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />

            <select name="disponibilidad"
                    class="rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                <option value="">Todas</option>
                <option value="disponible" selected="@(ViewBag.Disponibilidad == "disponible")">Disponible</option>
                <option value="bajo pedido" selected="@(ViewBag.Disponibilidad == "bajo pedido")">Bajo pedido</option>
                <option value="no disponible" selected="@(ViewBag.Disponibilidad == "no disponible")">No disponible</option>
            </select>

            <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition">
                Filtrar
            </button>
            <a href="/Proveedor" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
                Limpiar
            </a>
        </form>
    </div>

    @if (!Model.Servicios.Any())
    {
        <div class="mt-4 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-inbox text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No hay servicios que coincidan con el filtro.</p>
            <a href="/Proveedor/CrearServicio" class="mt-3 inline-block rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
                Publicar mi primer servicio
            </a>
        </div>
    }
    else
    {
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var servicio in Model.Servicios)
            {
                var estadoColor = servicio.Disponibilidad switch
                {
                    "disponible" => "bg-green-100 text-green-800",
                    "bajo pedido" => "bg-yellow-100 text-yellow-800",
                    _ => "bg-red-100 text-red-800"
                };
                var estadoTexto = servicio.Disponibilidad switch
                {
                    "disponible" => "Disponible",
                    "bajo pedido" => "Bajo pedido",
                    _ => "No disponible"
                };

                <div class="group rounded-2xl border border-border bg-card overflow-hidden card-soft transition hover:shadow-lg">
                    <div class="h-40 overflow-hidden bg-slate-100">
                        <img src="@(servicio.ImagenUrl ?? "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=600&q=70")"
                             alt="@servicio.Nombre"
                             class="h-full w-full object-cover transition group-hover:scale-105"
                             onerror="this.src='https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=600&q=70'" />
                    </div>
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <h3 class="font-semibold text-primary truncate">@servicio.Nombre</h3>
                                <p class="text-xs text-muted-foreground">@servicio.IdCategoriaNavigation?.Nombre</p>
                            </div>
                            <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium @estadoColor">@estadoTexto</span>
                        </div>
                        <p class="mt-2 line-clamp-2 text-xs text-muted-foreground">@servicio.Descripcion</p>

                        @if (servicio.CantidadMinima.HasValue && servicio.CantidadMaxima.HasValue)
                        {
                            <p class="mt-1 text-[10px] text-accent font-medium">
                                <i class="fa-solid fa-table"></i>
                                Matriz: @servicio.CantidadMinima - @servicio.CantidadMaxima (inc. @servicio.CantidadIncremento)
                            </p>
                        }

                        <div class="mt-3 flex items-center justify-between border-t border-border pt-3">
                            <span class="font-bold text-accent">$ @servicio.PrecioBase.ToString("N0")</span>
                            <select class="cambiar-disponibilidad text-xs rounded-md border border-border bg-white px-2 py-1 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
                                    data-id="@servicio.IdServicio"
                                    title="Cambiar disponibilidad">
                                <option value="disponible" selected="@(servicio.Disponibilidad == "disponible")">Disponible</option>
                                <option value="bajo pedido" selected="@(servicio.Disponibilidad == "bajo pedido")">Bajo pedido</option>
                                <option value="no disponible" selected="@(servicio.Disponibilidad == "no disponible")">No disponible</option>
                            </select>
                        </div>

                        <div class="mt-3 grid grid-cols-2 gap-2">
                            <a href="/Proveedor/EditarServicio/@servicio.IdServicio"
                               class="rounded-lg border border-border px-3 py-1.5 text-center text-xs hover:bg-secondary transition">
                                <i class="fa-solid fa-pen mr-1"></i>Editar
                            </a>
                            <a href="/Proveedor/ConfigurarMatriz/@servicio.IdServicio"
                               class="rounded-lg border border-accent/40 bg-accent/5 px-3 py-1.5 text-center text-xs font-medium text-accent hover:bg-accent/10 transition">
                                <i class="fa-solid fa-table mr-1"></i>Precios
                            </a>
                            <a href="/Proveedor/Calendario/@servicio.IdServicio"
                               class="rounded-lg border border-blue-300 bg-blue-50 px-3 py-1.5 text-center text-xs font-medium text-blue-700 hover:bg-blue-100 transition">
                                <i class="fa-solid fa-calendar mr-1"></i>Calendario
                            </a>
                            <form asp-controller="Proveedor" asp-action="DuplicarServicio" method="post">
                                <input type="hidden" name="id" value="@servicio.IdServicio" />
                                <button type="submit" class="w-full rounded-lg border border-border px-3 py-1.5 text-xs hover:bg-secondary transition">
                                    <i class="fa-solid fa-copy mr-1"></i>Duplicar
                                </button>
                            </form>
                            <form asp-controller="Proveedor" asp-action="EliminarServicio" method="post"
                                  onsubmit="return confirm('¿Estás seguro de eliminar este servicio?');"
                                  class="col-span-2">
                                <input type="hidden" name="id" value="@servicio.IdServicio" />
                                <button type="submit" class="w-full rounded-lg border border-red-200 px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 transition">
                                    <i class="fa-solid fa-trash mr-1"></i>Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Zona de peligro -->
    <div class="mt-12 rounded-2xl border border-red-200 bg-red-50/50 p-6">
        <h2 class="font-display text-lg font-bold text-red-800">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i> Zona de peligro
        </h2>
        <p class="mt-1 text-sm text-red-700">
            Estas acciones afectan tu cuenta como proveedor. Úsalas con cuidado.
        </p>

        <div class="mt-4 flex flex-wrap gap-3">
            <form asp-controller="Proveedor" asp-action="InhabilitarEmpresa" method="post"
                  onsubmit="return confirm('¿Inhabilitar tu empresa? Tus servicios dejarán de aparecer en el marketplace y no podrás iniciar sesión hasta que un administrador te reactive.');">
                <button type="submit" class="rounded-lg border border-yellow-400 bg-yellow-50 px-4 py-2 text-sm font-semibold text-yellow-800 hover:bg-yellow-100 transition">
                    <i class="fa-solid fa-eye-slash mr-1"></i> Inhabilitar empresa
                </button>
            </form>

            <form asp-controller="Proveedor" asp-action="EliminarEmpresa" method="post"
                  onsubmit="return confirm('¿Eliminar tu empresa permanentemente? Se borrarán todos tus servicios. Esta acción no se puede deshacer.');">
                <button type="submit" class="rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 transition">
                    <i class="fa-solid fa-trash mr-1"></i> Eliminar empresa
                </button>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Cambio rápido de disponibilidad con AJAX
        document.querySelectorAll('.cambiar-disponibilidad').forEach(sel => {
            sel.addEventListener('change', async (e) => {
                const id = e.target.dataset.id;
                const disponibilidad = e.target.value;

                let token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) {
                    const match = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/);
                    token = match ? match[1] : '';
                }

                const fd = new FormData();
                fd.append('id', id);
                fd.append('disponibilidad', disponibilidad);
                fd.append('__RequestVerificationToken', token);

                try {
                    const res = await fetch('/Proveedor/CambiarDisponibilidad', {
                        method: 'POST',
                        body: fd
                    });
                    if (!res.ok) throw new Error('Error');

                    e.target.classList.add('ring-2', 'ring-green-400');
                    setTimeout(() => e.target.classList.remove('ring-2', 'ring-green-400'), 800);
                } catch {
                    alert('No se pudo actualizar la disponibilidad.');
                }
            });
        });
    </script>
}