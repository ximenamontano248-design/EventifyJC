@model Proveedor

@{
    ViewData["Title"] = "Mi Negocio · Eventify JC";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">@Model.NombreComercial</h1>
            <p class="mt-1 text-muted-foreground">@Model.Ciudad · @Model.Categorias</p>
        </div>
        <div class="flex gap-3">
            <a href="/Proveedor/CrearServicio" class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground hover:bg-accent/90 transition">
                <i class="fa-solid fa-plus mr-2"></i> Publicar servicio
            </a>
        </div>
    </div>

    <!-- Información del negocio -->
    <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-border bg-card p-6 card-soft">
            <h3 class="font-semibold text-primary">Estado</h3>
            @if (Model.Verificado == true)
            {
                <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
                    <i class="fa-solid fa-check-circle"></i> Verificado
                </span>
            }
            else
            {
                <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-yellow-100 px-3 py-1 text-sm font-medium text-yellow-800">
                    <i class="fa-solid fa-clock"></i> Pendiente de verificación
                </span>
            }
        </div>
        <div class="rounded-2xl border border-border bg-card p-6 card-soft">
            <h3 class="font-semibold text-primary">Servicios</h3>
            <p class="mt-2 text-2xl font-bold text-primary">@Model.Servicios.Count</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6 card-soft">
            <h3 class="font-semibold text-primary">Calificación</h3>
            <p class="mt-2 text-2xl font-bold text-accent">@(Model.CalificacionPromedio?.ToString("F1") ?? "—")</p>
        </div>
    </div>

    <!-- Lista de servicios -->
    <div class="mt-12">
        <h2 class="font-display text-2xl font-bold text-primary">Mis servicios</h2>
        @if (!Model.Servicios.Any())
        {
            <div class="mt-4 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
                <p class="text-muted-foreground">Aún no has publicado ningún servicio.</p>
                <a href="/Proveedor/CrearServicio" class="mt-3 inline-block rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground hover:bg-accent/90 transition">
                    Publicar mi primer servicio
                </a>
            </div>
        }
        else
        {
            <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var servicio in Model.Servicios)
                {
                    <div class="group relative rounded-2xl border border-border bg-card overflow-hidden card-soft transition hover:shadow-lg">
                        <div class="h-40 overflow-hidden">
                            <img src="@(servicio.ImagenUrl ?? "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=600&q=70")"
                                 alt="@servicio.Nombre"
                                 class="h-full w-full object-cover transition group-hover:scale-105" />
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold text-primary">@servicio.Nombre</h3>
                            <p class="text-sm text-muted-foreground">@servicio.IdCategoriaNavigation.Nombre</p>
                            <div class="mt-2 flex items-center justify-between">
                                <span class="font-bold text-accent">$ @servicio.PrecioBase.ToString("N0")</span>
                                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-600">@servicio.Disponibilidad</span>
                            </div>
                            <div class="mt-3 flex gap-2">
                                <a href="/Proveedor/EditarServicio/@servicio.IdServicio" class="flex-1 rounded-lg border border-border px-3 py-1.5 text-center text-sm hover:bg-secondary transition">
                                    Editar
                                </a>
                                <form asp-controller="Proveedor" asp-action="EliminarServicio" method="post" onsubmit="return confirm('¿Estás seguro de eliminar este servicio?');">
                                    <input type="hidden" name="id" value="@servicio.IdServicio" />
                                    <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 transition">
                                        Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>