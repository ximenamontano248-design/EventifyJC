@model List<Cotizacion>
@{
    ViewData["Title"] = "Mis Cotizaciones · Eventify JC";
    var estadoFiltro = (string?)ViewBag.EstadoFiltro;
    var q = (string?)ViewBag.Q;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">Cotizaciones recibidas</h1>
            <p class="mt-1 text-muted-foreground">Responde y gestiona las solicitudes de tus clientes.</p>
        </div>
        <div class="flex gap-2">
            <a href="/Proveedor" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
                <i class="fa-solid fa-arrow-left mr-1"></i> Volver al panel
            </a>
            <a href="/Proveedor/Oportunidades" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
                <i class="fa-solid fa-bullseye mr-1"></i> Ver oportunidades
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    <!-- Métricas -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Total</p>
            <p class="mt-2 text-3xl font-bold text-primary">@ViewBag.TotalCotizaciones</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Enviadas</p>
            <p class="mt-2 text-3xl font-bold text-blue-600">@ViewBag.TotalEnviadas</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Aceptadas</p>
            <p class="mt-2 text-3xl font-bold text-green-600">@ViewBag.TotalAceptadas</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-5 card-soft">
            <p class="text-sm text-muted-foreground">Rechazadas</p>
            <p class="mt-2 text-3xl font-bold text-red-600">@ViewBag.TotalRechazadas</p>
        </div>
    </div>

    <!-- Filtros -->
    <form method="get" class="mb-6 flex flex-wrap gap-3">
        <input type="text" name="q" value="@q" placeholder="Buscar por cliente o descripción..."
               class="flex-1 min-w-[240px] rounded-lg border border-border px-3 py-2 text-sm" />

        <select name="estado" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todos los estados</option>
            <option value="enviada" selected="@(estadoFiltro == "enviada")">Enviadas</option>
            <option value="aceptada" selected="@(estadoFiltro == "aceptada")">Aceptadas</option>
            <option value="rechazada" selected="@(estadoFiltro == "rechazada")">Rechazadas</option>
            <option value="expirada" selected="@(estadoFiltro == "expirada")">Expiradas</option>
        </select>

        <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm text-white font-medium hover:bg-accent/90 transition">
            Filtrar
        </button>
        <a href="/Proveedor/Cotizaciones" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            Limpiar
        </a>
    </form>

    <!-- Lista -->
    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-inbox text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No hay cotizaciones con esos filtros.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var cot in Model)
            {
                var badgeClass = cot.Estado switch
                {
                    "aceptada" => "bg-green-100 text-green-800",
                    "rechazada" => "bg-red-100 text-red-800",
                    "expirada" => "bg-gray-100 text-gray-800",
                    _ => "bg-blue-100 text-blue-800"
                };
                var badgeText = cot.Estado switch
                {
                    "aceptada" => "Aceptada",
                    "rechazada" => "Rechazada",
                    "expirada" => "Expirada",
                    _ => "Enviada"
                };

                <div class="rounded-2xl border border-border bg-card p-5 card-soft hover:shadow-md transition">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-primary">
                                    @cot.IdServicioNavigation?.Nombre
                                </h3>
                                <span class="rounded-full px-2.5 py-0.5 text-xs font-medium @badgeClass">
                                    @badgeText
                                </span>
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">
                                <i class="fa-solid fa-user mr-1"></i>
                                @cot.IdSolicitudNavigation?.IdOrganizadorNavigation?.Nombre
                                · <i class="fa-solid fa-calendar ml-2 mr-1"></i>
                                Evento: @cot.IdSolicitudNavigation?.FechaEvento.ToString("dd/MM/yyyy")
                            </p>
                            <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
                                @cot.IdSolicitudNavigation?.DescripcionEvento
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs uppercase tracking-wider text-muted-foreground">Monto</p>
                            <p class="text-2xl font-bold text-accent">$ @cot.Monto.ToString("N0")</p>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-t border-border flex flex-wrap gap-2 items-center justify-between">
                        <p class="text-xs text-muted-foreground">
                            <i class="fa-solid fa-clock mr-1"></i>
                            Enviada: @cot.FechaEnvio?.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <div class="flex gap-2">
                            <a href="/Proveedor/DetalleCotizacion/@cot.IdCotizacion"
                               class="rounded-lg border border-border px-3 py-1.5 text-xs hover:bg-secondary transition">
                                <i class="fa-solid fa-eye mr-1"></i> Ver detalle
                            </a>

                            @if (cot.Estado == "enviada")
                            {
                                <form asp-controller="Proveedor" asp-action="CambiarEstadoCotizacion" method="post" class="inline">
                                    <input type="hidden" name="id" value="@cot.IdCotizacion" />
                                    <input type="hidden" name="estado" value="aceptada" />
                                    <button type="submit" class="rounded-lg bg-green-600 px-3 py-1.5 text-xs text-white hover:bg-green-700 transition">
                                        <i class="fa-solid fa-check mr-1"></i> Aceptar
                                    </button>
                                </form>
                                <form asp-controller="Proveedor" asp-action="CambiarEstadoCotizacion" method="post" class="inline">
                                    <input type="hidden" name="id" value="@cot.IdCotizacion" />
                                    <input type="hidden" name="estado" value="rechazada" />
                                    <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 transition">
                                        <i class="fa-solid fa-times mr-1"></i> Rechazar
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>