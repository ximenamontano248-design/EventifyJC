@model List<SolicitudCotizacion>
@{
    ViewData["Title"] = "Oportunidades · Eventify JC";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <a href="/Proveedor/Cotizaciones" class="inline-flex items-center text-sm text-accent hover:underline mb-4">
        <i class="fa-solid fa-arrow-left mr-2"></i> Volver a cotizaciones
    </a>

    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="font-display text-3xl font-extrabold text-primary">Oportunidades</h1>
            <p class="mt-1 text-muted-foreground">Solicitudes activas a las que aún no has cotizado.</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
            <i class="fa-solid fa-exclamation-circle mr-1"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-check-circle text-4xl text-green-500"></i>
            <p class="mt-3 text-muted-foreground">¡Todo al día! No hay solicitudes pendientes sin cotizar.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var sol in Model)
            {
                <div class="rounded-2xl border border-border bg-card p-5 card-soft hover:shadow-md transition">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-primary">Solicitud #@sol.IdSolicitud</h3>
                                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">
                                    @sol.Estado
                                </span>
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">
                                <i class="fa-solid fa-user mr-1"></i>
                                @sol.IdOrganizadorNavigation?.Nombre
                                · <i class="fa-solid fa-calendar ml-2 mr-1"></i>
                                @sol.FechaEvento.ToString("dd/MM/yyyy")
                            </p>
                            <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
                                @sol.DescripcionEvento
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs uppercase tracking-wider text-muted-foreground">Presupuesto</p>
                            <p class="text-xl font-bold text-accent">
                                $ @(sol.PresupuestoEstimado?.ToString("N0") ?? "—")
                            </p>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
                        <p class="text-xs text-muted-foreground">
                            <i class="fa-solid fa-clock mr-1"></i>
                            Publicada: @sol.FechaSolicitud?.ToString("dd/MM/yyyy")
                        </p>

                       <a asp-controller="Proveedor" asp-action="ResponderSolicitud" asp-route-id="@sol.IdSolicitud"
   class="rounded-lg bg-accent px-4 py-1.5 text-xs font-semibold text-white hover:bg-accent/90 transition">
    <i class="fa-solid fa-reply mr-1"></i> Ver y responder
</a>
                    </div>
                </div>
            }
        </div>
    }
</div>