@model EventifyJC.Models.ServicioViewModel

@{
    ViewData["Title"] = "Publicar Servicio";
}

<div class="max-w-3xl mx-auto py-10 px-4">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Publicar nuevo servicio</h2>

        <form asp-action="CrearServicio" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Categoría</label>
                    <select asp-for="IdCategoria" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent">
                        <option value="">Seleccione una categoría</option>
                        @foreach (var cat in ViewBag.Categorias as List<Categorium>)
                        {
                            <option value="@cat.IdCategoria">@cat.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="IdCategoria" class="text-red-500 text-xs"></span>
                </div>

                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre del servicio</label>
                    <input asp-for="Nombre" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent" placeholder="Ej: Decoración completa para bodas" />
                    <span asp-validation-for="Nombre" class="text-red-500 text-xs"></span>
                </div>

                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                    <textarea asp-for="Descripcion" rows="4" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent" placeholder="Describe los detalles del servicio..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Precio base (COP)</label>
                    <input asp-for="PrecioBase" type="number" step="0.01" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent" placeholder="0.00" />
                    <span asp-validation-for="PrecioBase" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Disponibilidad</label>
                    <input asp-for="Disponibilidad" type="text" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent focus:border-accent" placeholder="Ej: Disponible los fines de semana" />
                    <span asp-validation-for="Disponibilidad" class="text-red-500 text-xs"></span>
                </div>

                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Imagen del servicio (opcional)</label>
                    <input asp-for="Imagen" type="file" class="w-full border border-gray-300 rounded-lg px-4 py-2" accept="image/*" />
                </div>
            </div>

            <div class="mt-8 flex justify-end space-x-3">
                <a href="/Proveedor" class="px-6 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancelar</a>
                <button type="submit" class="px-6 py-2.5 bg-accent text-white rounded-lg hover:bg-accent/90 transition">Publicar servicio</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}