@model ProveedorViewModel

@{
    ViewData["Title"] = "Registro de proveedor · Eventify JC";
    var categoriasDisponibles = new[]
    {
        "Catering", "Decoración", "Música", "Fotografía", "Video",
        "Sonido", "Iluminación", "Repostería", "Salones", "Animación", "Wedding Planner"
    };
}

<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
    theme: {
    extend: {
    colors: {
    primary: "#1b2340", accent: "#e8823c", "accent-foreground": "#1b1206",
    background: "#ffffff", foreground: "#1b2340", card: "#ffffff",
    border: "#e6e5e0", "muted-foreground": "#6b7080",
    },
    fontFamily: { display: ["Poppins", "sans-serif"] },
    },
    },
    };
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
    body {
    font-family: 'Inter', sans-serif;
    }

    .card-soft {
    box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06);
    }
</style>


<div class="min-h-screen bg-background">
    <section class="mx-auto max-w-3xl px-6 py-12">
        <div class="rounded-2xl border border-border bg-card p-8 card-soft">
            <h1 class="font-display text-2xl font-bold text-primary">Registro de proveedor</h1>
            <p class="mt-1 text-sm text-muted-foreground">
                Crea tu perfil empresarial y empieza a recibir solicitudes en toda Colombia.
            </p>

            <div asp-validation-summary="All" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

            <form asp-controller="Proveedor" asp-action="Create" method="post" enctype="multipart/form-data" class="mt-6 space-y-7">

                <!-- Datos del negocio -->
                <fieldset class="space-y-4">
                    <legend class="font-display font-semibold text-primary">Datos del negocio</legend>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label asp-for="NombreComercial" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="NombreComercial" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="NombreComercial" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="RazonSocial" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="RazonSocial" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="RazonSocial" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="Nit" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Nit" placeholder="900123456-7" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="Nit" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="Representante" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Representante" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="Representante" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="TelefonoNegocio" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="TelefonoNegocio" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="TelefonoNegocio" class="text-xs text-red-600"></span>
                        </div>
                    </div>
                </fieldset>

                <!-- Ubicación y cobertura -->
                <fieldset class="space-y-4">
                    <legend class="font-display font-semibold text-primary">Ubicación y cobertura</legend>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label asp-for="Ciudad" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Ciudad" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="Ciudad" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="Direccion" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Direccion" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                            <span asp-validation-for="Direccion" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="NivelCobertura" class="block text-sm font-medium text-primary"></label>
                            <select asp-for="NivelCobertura" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                                <option value="municipal">Municipal</option>
                                <option value="departamental">Departamental</option>
                                <option value="nacional">Nacional</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="CiudadesCubiertas" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="CiudadesCubiertas" placeholder="Bogotá, Chía, Cajicá" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                    </div>
                </fieldset>

                <!-- Servicios -->
                <fieldset class="space-y-4">
                    <legend class="font-display font-semibold text-primary">Servicios que ofreces *</legend>
                    <div class="flex flex-wrap gap-2" id="categoriasBotones">
                        @foreach (var c in categoriasDisponibles)
                        {
                            <button type="button" data-cat="@c"
                                    class="cat-btn rounded-full border border-border bg-card px-3 py-1.5 text-xs text-muted-foreground transition hover:border-accent/50">
                                @c
                            </button>
                        }
                    </div>
                    <input type="hidden" asp-for="Categorias" id="categoriasInput" />
                    <span asp-validation-for="Categorias" class="text-xs text-red-600"></span>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label asp-for="Descripcion" class="block text-sm font-medium text-primary"></label>
                            <textarea asp-for="Descripcion" rows="3" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></textarea>
                        </div>
                        <div>
                            <label asp-for="Tarifas" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Tarifas" placeholder="Desde $1.500.000 COP" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                        <div>
                            <label asp-for="Capacidad" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Capacidad" placeholder="50 - 500 personas" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                        <div>
                            <label asp-for="AnticipacionRequerida" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="AnticipacionRequerida" placeholder="Mínimo 15 días" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                    </div>
                </fieldset>

                <!-- Portafolio -->
                <fieldset class="space-y-4">
                    <legend class="font-display font-semibold text-primary">Portafolio</legend>

                    <div class="flex items-center gap-4">
                        <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-xl border border-dashed border-border bg-secondary/40">
                            <img id="logoPreview" src="" alt="Vista previa del logo" class="hidden h-full w-full object-cover" />
                            <span id="logoPlaceholder" class="text-[10px] text-muted-foreground text-center px-1">Sin logo</span>
                        </div>
                        <div class="flex-1">
                            <label asp-for="Logo" class="block text-sm font-medium text-primary">Logo del negocio</label>
                            <input asp-for="Logo" type="file" accept="image/png,image/jpeg,image/webp" id="logoInput"
                                   class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-accent/10 file:px-3 file:py-1.5 file:text-accent" />
                            <span asp-validation-for="Logo" class="text-xs text-red-600"></span>
                            <p class="mt-1 text-[11px] text-muted-foreground">JPG, PNG o WEBP · máx. 3MB</p>
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label asp-for="Galeria" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Galeria" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                        <div>
                            <label asp-for="Videos" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Videos" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                    </div>
                </fieldset>

                <!-- Redes -->
                <fieldset class="space-y-4">
                    <legend class="font-display font-semibold text-primary">Redes y contacto</legend>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label asp-for="Whatsapp" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Whatsapp" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                        <div>
                            <label asp-for="Instagram" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Instagram" placeholder="@@usuario" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                        <div>
                            <label asp-for="Facebook" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="Facebook" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                        <div>
                            <label asp-for="SitioWeb" class="block text-sm font-medium text-primary"></label>
                            <input asp-for="SitioWeb" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                        </div>
                    </div>
                </fieldset>

                <div class="rounded-xl border border-border bg-secondary/40 p-4">
                    <label class="flex cursor-pointer items-start gap-3 text-sm">
                        <input type="checkbox" asp-for="AceptaTratamientoDatos" class="mt-0.5" />
                        <span>
                            Autorizo el tratamiento de datos personales conforme a la <strong>Ley 1581 de 2012</strong> y acepto las políticas de privacidad de Eventify JC.
                        </span>
                    </label>
                    <span asp-validation-for="AceptaTratamientoDatos" class="text-xs text-red-600"></span>
                </div>

                <button type="submit" class="flex w-full items-center justify-center rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-foreground hover:bg-accent/90">
                    Registrar mi negocio
                </button>
            </form>
        </div>
    </section>
</div>

<script>
    // Categorías: alterna selección y arma el CSV en el input oculto
    const categoriasSeleccionadas = new Set();
    document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
    const cat = btn.dataset.cat;
    if (categoriasSeleccionadas.has(cat)) {
    categoriasSeleccionadas.delete(cat);
    btn.classList.remove('border-accent', 'bg-accent', 'text-accent-foreground');
    btn.classList.add('border-border', 'bg-card', 'text-muted-foreground');
    } else {
    categoriasSeleccionadas.add(cat);
    btn.classList.add('border-accent', 'bg-accent', 'text-accent-foreground');
    btn.classList.remove('border-border', 'bg-card', 'text-muted-foreground');
    }
    document.getElementById('categoriasInput').value = Array.from(categoriasSeleccionadas).join(',');
    });
    });

    // Vista previa del logo
    document.getElementById('logoInput').addEventListener('change', function (e) {
    const file = e.target.files[0];
    const preview = document.getElementById('logoPreview');
    const placeholder = document.getElementById('logoPlaceholder');
    if (!file) {
    preview.classList.add('hidden');
    placeholder.classList.remove('hidden');
    return;
    }
    const reader = new FileReader();
    reader.onload = function (ev) {
    preview.src = ev.target.result;
    preview.classList.remove('hidden');
    placeholder.classList.add('hidden');
    };
    reader.readAsDataURL(file);
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}