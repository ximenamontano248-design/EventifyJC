@model Categorium

@{
    ViewData["Title"] = "Editar categoría · Eventify JC";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="rounded-2xl border border-border bg-card p-8 card-soft">
        <h1 class="font-display text-2xl font-bold text-primary">Editar categoría</h1>

        <div asp-validation-summary="All" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

        <form asp-controller="Admin" asp-action="EditarCategoria" method="post" class="mt-6 space-y-5">
            <input type="hidden" asp-for="IdCategoria" />

            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-primary"></label>
                <input asp-for="Nombre" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="Nombre" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Descripcion" class="block text-sm font-medium text-primary"></label>
                <textarea asp-for="Descripcion" rows="3" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></textarea>
                <span asp-validation-for="Descripcion" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Link" class="block text-sm font-medium text-primary">Icono (opcional)</label>
                <input asp-for="Link" placeholder="fa-utensils" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="Link" class="text-xs text-red-600"></span>
                <p class="mt-1 text-xs text-muted-foreground">Clase de FontAwesome, ej: fa-utensils, fa-camera, etc.</p>
            </div>

            <button type="submit" class="flex w-full items-center justify-center rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-foreground hover:bg-accent/90 transition">
                <i class="fa-solid fa-save mr-2"></i> Actualizar categoría
            </button>
        </form>
    </div>
</div>