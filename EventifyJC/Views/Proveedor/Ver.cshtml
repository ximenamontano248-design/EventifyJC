@model Proveedor
@{
    ViewData["Title"] = $"{Model.NombreComercial} · Eventify JC";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <a href="javascript:history.back()" class="inline-flex items-center text-sm text-accent hover:underline mb-6">
        <i class="fa-solid fa-arrow-left mr-2"></i> Volver
    </a>

    <!-- Cabecera del negocio -->
    <div class="rounded-2xl border border-border bg-card overflow-hidden card-soft">
        <div class="brand-gradient h-32 relative">
            <div class="absolute bottom-0 left-6 translate-y-1/2">
                <div class="h-24 w-24 rounded-2xl border-4 border-white bg-white overflow-hidden shadow-lg">
                    <img src="@(Model.LogoUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.NombreComercial ?? "Negocio")}&background=e8823c&color=fff&size=200")"
                         alt="@Model.NombreComercial" class="h-full w-full object-cover" />
                </div>
            </div>
        </div>
        <div class="pt-16 pb-6 px-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="font-display text-2xl font-extrabold text-primary">@Model.NombreComercial</h1>
                        @if (Model.Verificado == true)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-800">
                                <i class="fa-solid fa-check-circle"></i> Verificado
                            </span>
                        }
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground">
                        <i class="fa-solid fa-location-dot mr-1"></i> @Model.Ciudad
                        @if (!string.IsNullOrWhiteSpace(Model.Categorias))
                        {
                            <span> · <i class="fa-solid fa-tags mx-1"></i> @Model.Categorias</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                    {
                        <p class="mt-3 text-sm text-muted-foreground max-w-2xl">@Model.Descripcion</p>
                    }
                </div>
                <div class="text-right">
                    <div class="text-3xl font-bold text-accent">@(Model.CalificacionPromedio?.ToString("F1") ?? "—") ★</div>
                    <p class="text-xs text-muted-foreground">Calificación promedio</p>
                </div>
            </div>

            <!-- Datos de contacto -->
            <div class="mt-6 flex flex-wrap gap-3 text-sm">
                @if (!string.IsNullOrWhiteSpace(Model.TelefonoNegocio))
                {
                    <span class="inline-flex items-center gap-2 rounded-lg bg-secondary/50 px-3 py-1.5">
                        <i class="fa-solid fa-phone text-accent"></i> @Model.TelefonoNegocio
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Whatsapp))
                {
                    <a href="https://wa.me/@Model.Whatsapp" target="_blank"
                       class="inline-flex items-center gap-2 rounded-lg bg-green-50 px-3 py-1.5 text-green-800 hover:bg-green-100 transition">
                        <i class="fa-brands fa-whatsapp"></i> WhatsApp
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Instagram))
                {
                    <a href="@Model.Instagram" target="_blank"
                       class="inline-flex items-center gap-2 rounded-lg bg-pink-50 px-3 py-1.5 text-pink-800 hover:bg-pink-100 transition">
                        <i class="fa-brands fa-instagram"></i> Instagram
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SitioWeb))
                {
                    <a href="@Model.SitioWeb" target="_blank"
                       class="inline-flex items-center gap-2 rounded-lg bg-secondary/50 px-3 py-1.5 hover:bg-secondary transition">
                        <i class="fa-solid fa-globe text-accent"></i> Sitio web
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Servicios (LISTADO SIN IMAGEN) -->
    <div class="mt-10 flex items-end justify-between">
        <div>
            <h2 class="font-display text-2xl font-bold text-primary">Servicios publicados</h2>
            <p class="mt-1 text-sm text-muted-foreground">@Model.Servicios.Count servicios disponibles</p>
        </div>
    </div>

    @if (!Model.Servicios.Any())
    {
        <div class="mt-4 rounded-2xl border border-dashed border-border bg-card p-12 text-center text-muted-foreground">
            <i class="fa-solid fa-inbox text-3xl mb-2"></i>
            <p>Este proveedor aún no ha publicado servicios.</p>
        </div>
    }
    else
    {
        <div class="mt-6 rounded-2xl border border-border bg-card overflow-hidden card-soft divide-y divide-border">
            @foreach (var servicio in Model.Servicios)
            {
                <div class="flex flex-wrap items-center gap-4 p-5 hover:bg-secondary/20 transition">

                    <!-- Icono de categoría -->
                    <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>

                    <!-- Info principal -->
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-semibold text-primary truncate">@servicio.Nombre</h3>
                            <span class="rounded-full bg-secondary/60 px-2.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                                @servicio.IdCategoriaNavigation?.Nombre
                            </span>
                            @if (servicio.Disponibilidad == "disponible")
                            {
                                <span class="rounded-full bg-green-100 px-2.5 py-0.5 text-[10px] font-medium text-green-800">
                                    Disponible
                                </span>
                            }
                            else if (servicio.Disponibilidad == "bajo pedido")
                            {
                                <span class="rounded-full bg-yellow-100 px-2.5 py-0.5 text-[10px] font-medium text-yellow-800">
                                    Bajo pedido
                                </span>
                            }
                            else
                            {
                                <span class="rounded-full bg-red-100 px-2.5 py-0.5 text-[10px] font-medium text-red-800">
                                    No disponible
                                </span>
                            }
                        </div>
                        <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@servicio.Descripcion</p>
                    </div>

                    <!-- Precio -->
                    <div class="text-right shrink-0">
                        <span class="block text-[10px] uppercase tracking-wider text-muted-foreground">Desde</span>
                        <span class="font-bold text-accent text-lg">$ @servicio.PrecioBase.ToString("N0")</span>
                    </div>

               <!-- CTA -->
<div class="shrink-0">
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("organizador"))
    {
        <a asp-controller="Organizador" asp-action="CotizarServicio" asp-route-id="@servicio.IdServicio"
           class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent/90 transition">
            <i class="fa-solid fa-paper-plane mr-2"></i> Cotizar
        </a>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <button type="button" disabled
                class="inline-flex items-center rounded-lg border border-border px-4 py-2 text-sm text-muted-foreground cursor-not-allowed">
            Ver detalle
        </button>
    }
    else
    {
        <a href="/Account/Login?returnUrl=/Proveedor/Ver/@Model.IdProveedor"
           class="inline-flex items-center rounded-lg border border-accent px-4 py-2 text-sm font-semibold text-accent hover:bg-accent/10 transition">
            <i class="fa-solid fa-sign-in-alt mr-2"></i> Iniciar sesión
        </a>
    }
</div>
                </div>
            }
        </div>
    }
</div>