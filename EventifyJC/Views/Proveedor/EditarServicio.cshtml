@model ServicioViewModel
@{
    ViewData["Title"] = "Editar servicio · Eventify JC";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <a href="/Proveedor" class="inline-flex items-center text-sm text-accent hover:underline mb-4">
        <i class="fa-solid fa-arrow-left mr-2"></i> Volver a mi negocio
    </a>

    <div class="rounded-2xl border border-border bg-card p-8 card-soft">
        <h1 class="font-display text-2xl font-bold text-primary">Editar servicio</h1>
        <p class="mt-1 text-sm text-muted-foreground">Actualiza la información de tu servicio.</p>

        <div asp-validation-summary="All" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700"></div>

        <form asp-controller="Proveedor" asp-action="EditarServicio" method="post" enctype="multipart/form-data" class="mt-6 space-y-5">
            <input type="hidden" asp-for="IdServicio" />
            <input type="hidden" asp-for="ImagenUrl" />

            <div>
                <label asp-for="IdCategoria" class="block text-sm font-medium text-primary"></label>
                <select asp-for="IdCategoria"
                        asp-items="@(new SelectList(ViewBag.Categorias, "IdCategoria", "Nombre"))"
                        class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                    <option value="">Seleccionar categoría...</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-primary"></label>
                <input asp-for="Nombre" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                <span asp-validation-for="Nombre" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Descripcion" class="block text-sm font-medium text-primary"></label>
                <textarea asp-for="Descripcion" rows="3" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></textarea>
                <span asp-validation-for="Descripcion" class="text-xs text-red-600"></span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="PrecioBase" class="block text-sm font-medium text-primary"></label>
                    <input asp-for="PrecioBase" type="number" step="1000" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
                    <span asp-validation-for="PrecioBase" class="text-xs text-red-600"></span>
                    <p class="mt-1 text-xs text-muted-foreground">Precio base en pesos colombianos (COP). Ej: 400000 = $400.000.</p>
                </div>
                <div>
                    <label asp-for="Disponibilidad" class="block text-sm font-medium text-primary"></label>
                    <select asp-for="Disponibilidad" class="mt-1 w-full rounded-lg border border-border px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                        <option value="disponible">Disponible</option>
                        <option value="no disponible">No disponible</option>
                        <option value="bajo pedido">Bajo pedido</option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <div>
                    <label class="block text-sm font-medium text-primary">Imagen actual</label>
                    <img src="@Model.ImagenUrl" alt="Imagen del servicio"
                         class="mt-1 h-32 w-32 rounded-lg object-cover border border-border" />
                </div>
            }

            <div>
                <label asp-for="Imagen" class="block text-sm font-medium text-primary">Nueva imagen (opcional)</label>
                <input type="file" asp-for="Imagen" accept="image/*" class="mt-1 w-full text-sm" />
                <p class="mt-1 text-xs text-muted-foreground">Deja vacío para mantener la imagen actual.</p>
            </div>

            <button type="submit" class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
                <i class="fa-solid fa-save mr-1"></i> Guardar cambios
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}