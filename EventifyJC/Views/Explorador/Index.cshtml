@model List<ServiceDto>
@{
    ViewData["Title"] = "Servicios · Eventify JC";
    bool logueado = (bool)ViewBag.EstaLogueado;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">Servicios disponibles</h1>

    <p class="mt-1 text-muted-foreground">
        @ViewBag.TotalResultados servicio@(ViewBag.TotalResultados == 1 ? "" : "s") encontrado@(ViewBag.TotalResultados == 1 ? "" : "s")
    </p>

    @if (!logueado)
    {
        <div class="mt-4 rounded-xl border border-accent/30 bg-accent/5 px-4 py-2 text-sm text-primary">
            <i class="fa-solid fa-info-circle text-accent"></i>
            <a href="/Account/Login" class="font-semibold text-accent hover:underline">Inicia sesión</a> para solicitar cotizaciones.
        </div>
    }

    <form method="get" class="mt-6 flex flex-wrap gap-3">
        <input type="text" name="q" value="@ViewBag.Q" placeholder="Buscar servicio o proveedor..."
               class="flex-1 min-w-[200px] rounded-lg border border-border px-3 py-2 text-sm" />

        <select name="categoriaId" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todas las categorías</option>
            @foreach (var cat in (List<Categorium>)ViewBag.Categorias)
            {
                <option value="@cat.IdCategoria" selected="@(ViewBag.CategoriaId == cat.IdCategoria)">@cat.Nombre</option>
            }
        </select>

        <!-- NUEVO: Filtro de ciudad -->
        <select name="ciudad" class="rounded-lg border border-border px-3 py-2 text-sm">
            <option value="">Todas las ciudades</option>
            @foreach (var ciudad in (List<string>)ViewBag.Ciudades)
            {
                <option value="@ciudad" selected="@(ViewBag.Ciudad == ciudad)">@ciudad</option>
            }
        </select>

        <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm text-white font-medium hover:bg-accent/90 transition">
            Buscar
        </button>
        <a href="/Explorador" class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-secondary transition">
            Limpiar
        </a>
    </form>

    @if (!Model.Any())
    {
        <div class="mt-10 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <i class="fa-solid fa-search text-4xl text-muted-foreground"></i>
            <p class="mt-3 text-muted-foreground">No encontramos servicios con esos filtros.</p>
        </div>
    }
    else
    {
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @foreach (var s in Model)
            {
                <a href="/Explorador/Detalle/@s.Id"
                   class="group rounded-2xl border border-border bg-card overflow-hidden card-soft transition hover:shadow-lg flex flex-col">

                    <!-- Imagen -->
                    <div class="relative h-40 overflow-hidden bg-slate-100">
                        <img src="@(s.ImagenUrl ?? "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=600&q=70")"
                             alt="@s.Nombre"
                             class="h-full w-full object-cover transition group-hover:scale-105"
                             onerror="this.src='https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=600&q=70'" />

                        @if (s.Verificado)
                        {
                            <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-full bg-accent px-2.5 py-1 text-[10px] font-semibold text-white shadow">
                                <i class="fa-solid fa-check-circle"></i> Verificado
                            </span>
                        }
                    </div>

                    <!-- Contenido -->
                    <div class="p-4 flex flex-col flex-1">
                        <span class="self-start rounded-full bg-secondary/60 px-2.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                            @s.CategoriaNombre
                        </span>

                        <h3 class="mt-2 font-semibold text-primary truncate group-hover:text-accent transition">
                            @s.Nombre
                        </h3>

                        <p class="text-xs text-muted-foreground truncate mt-1">
                            <i class="fa-solid fa-store mr-1"></i>@s.ProveedorNombre
                            · <i class="fa-solid fa-location-dot ml-1 mr-1"></i>@s.Ciudad
                        </p>

                        <div class="mt-2 flex items-center gap-1 text-xs">
                            <span class="text-yellow-500">★</span>
                            <span class="font-medium">@s.CalificacionPromedio.ToString("F1")</span>
                        </div>

                        <!-- Precio + Botón Ver -->
                        <div class="mt-auto pt-3 flex items-center justify-between border-t border-border">
                            <div>
                                <span class="text-[10px] uppercase tracking-wider text-muted-foreground block">Desde</span>
                                <span class="font-bold text-accent">$ @s.PrecioBase.ToString("N0")</span>
                            </div>

                            <span class="rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white group-hover:bg-accent/90 transition">
                                <i class="fa-solid fa-eye mr-1"></i> Ver
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>