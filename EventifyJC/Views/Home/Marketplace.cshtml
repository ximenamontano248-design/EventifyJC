@* /Views/Home/Marketplace.cshtml *@
@model MarketplaceViewModel

@{
    ViewData["Title"] = "Marketplace de servicios para eventos · Eventify JC";
    ViewData["Description"] = "Explora, compara y cotiza servicios reales de proveedores verificados de eventos en Colombia.";
    ViewData["OgTitle"] = "Marketplace de servicios para eventos · Eventify JC";
    ViewData["OgDescription"] = "Catering, decoración, música, fotografía y más en toda Colombia.";
}

@{
    // Filtros desde QueryString
    var q = Context.Request.Query["q"].ToString();
    var category = Context.Request.Query["category"].ToString();
    var city = Context.Request.Query["city"].ToString();
    var verified = Context.Request.Query["verified"].ToString() == "true";
}

<section class="border-b border-border bg-secondary/40">
    <div class="mx-auto max-w-7xl px-6 py-10">
        <h1 class="font-display text-3xl font-extrabold text-primary sm:text-4xl">
            Marketplace de servicios
        </h1>
        <p class="mt-2 text-muted-foreground">
            @Model.Servicios.Count() servicios disponibles · Compara, cotiza y contrata
        </p>

        <form method="get" class="mt-6 flex flex-col gap-3 sm:flex-row">
            <div class="flex flex-1 items-center gap-2 rounded-xl border border-border bg-card px-4">
                <svg class="h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" name="q" value="@q" placeholder="Buscar servicio o proveedor…"
                       class="w-full border-0 bg-transparent shadow-none focus:outline-none focus:ring-0" />
            </div>
            <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-foreground hover:bg-accent/90 transition">
                Buscar
            </button>
            <a href="/marketplace" class="inline-flex items-center justify-center rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-secondary transition">
                Limpiar
            </a>
        </form>

        <div class="mt-5 flex flex-wrap gap-2">
            <a href="/marketplace"
               class="rounded-full px-3 py-1.5 text-sm @(string.IsNullOrEmpty(category) ? "bg-accent text-accent-foreground" : "bg-card text-foreground hover:bg-secondary") border transition">
                Todas
            </a>
            @foreach (var cat in Model.Categorias)
            {
                <a href="/marketplace?category=@cat.IdCategoria&q=@q&city=@city&verified=@verified"
                   class="rounded-full px-3 py-1.5 text-sm @(category == cat.IdCategoria.ToString() ? "border-accent bg-accent text-accent-foreground" : "bg-card text-foreground hover:bg-secondary") border transition">
                    @cat.Nombre
                </a>
            }
        </div>
    </div>
</section>

<section class="mx-auto grid max-w-7xl gap-8 px-6 py-10 lg:grid-cols-[280px_1fr]">
    <aside class="space-y-6 self-start rounded-2xl border border-border bg-card p-5 card-soft">
        <h3 class="font-display text-base font-bold text-primary">Filtros</h3>

        <div>
            <label class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Ciudad</label>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var c in Model.Cities)
                {
                    <a href="/marketplace?city=@c&q=@q&category=@category&verified=@verified"
                       class="rounded-full border px-2.5 py-1 text-xs transition @(city == c ? "border-accent bg-accent text-accent-foreground" : "border-border bg-background hover:bg-secondary")">
                        @c
                    </a>
                }
                @if (!Model.Cities.Any())
                {
                    <span class="text-xs text-muted-foreground">Sin datos aún</span>
                }
            </div>
        </div>

        <div>
            <label class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Proveedores destacados
            </label>
            <div class="mt-2 flex gap-1.5">
                <a href="/marketplace?verified=false&q=@q&category=@category&city=@city"
                   class="flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs @(!verified ? "border-accent bg-accent text-accent-foreground" : "border-border bg-background hover:bg-secondary")">
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                    Todos
                </a>
                <a href="/marketplace?verified=true&q=@q&category=@category&city=@city"
                   class="flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs @(verified ? "border-accent bg-accent text-accent-foreground" : "border-border bg-background hover:bg-secondary")">
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Verificados
                </a>
            </div>
        </div>

        <a href="/marketplace" class="inline-flex w-full items-center justify-center rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-secondary transition">
            Limpiar filtros
        </a>
    </aside>

    <div class="space-y-10">
        @if (!Model.Servicios.Any())
        {
            <div class="rounded-2xl border border-dashed border-border bg-card p-12 text-center">
                <p class="text-muted-foreground">No encontramos servicios con esos filtros.</p>
            </div>
        }
        else
        {
            @foreach (var group in Model.Servicios.GroupBy(s => s.CategoriaNombre))
            {
                <div>
                    <h2 class="font-display text-xl font-bold text-primary">@group.Key</h2>
                    <div class="mt-4 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                        @foreach (var servicio in group)
                        {
                            @await Html.PartialAsync("_ServiceCard", servicio)
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>